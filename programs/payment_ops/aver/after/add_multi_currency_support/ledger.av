module Ledger
    intent =
        "Pure replay and dedupe helpers for the payment ledger."
        "Backoffice review gets easier when webhook ingestion becomes append-only events"
        "and every current state is rebuilt from those events in plain code."
        "Every payment pins its canonical currency to the first event. Later events in a"
        "different currency are surfaced as anomalies and their amounts are never mixed"
        "into the canonical totals — there is no silent conversion inside this module."
    exposes [eventName, eventAt, hasSourceId, nextSeq, eventsForPayment, replayPayment, replayAll]
    depends [Types]

decision ReplayEverythingFromCanonicalEvents
    date = "2026-03-12"
    author = "Codex"
    reason =
        "Dirty payment integrations are easiest to audit when the stored history stays immutable."
        "Replaying canonical events keeps dedupe and reconciliation readable instead of hiding rules in writes."
    chosen = "AppendOnlyReplay"
    rejected = ["MutablePaymentRows", "AdHocStatusOverrides"]
    impacts = [hasSourceId, nextSeq, replayPayment, replayAll]

decision NeverSumAcrossCurrencies
    date = "2026-04-16"
    author = "Codex"
    reason =
        "Production traffic really does switch currencies mid-payment (authorized in USD,"
        "refunded in the local currency Stripe sold). Silently adding those integers would"
        "fabricate numbers and hide risk. Pinning the canonical currency to the first event"
        "and pushing every off-currency event into an anomaly keeps the sums honest and the"
        "mismatch visible to manual review."
    chosen = "PinCanonicalCurrencyAndAnomaliseMismatches"
    rejected = ["SilentSum", "SilentConversion", "RejectMixedCurrencyPayments"]
    impacts = [applyEvent, applyAuthorized, applyCaptured, applyRefunded]

fn eventName(event: PaymentEvent) -> String
    ? "Stable display name for one canonical event."
    match event
        PaymentEvent.Authorized(_, _, _) -> "Authorized"
        PaymentEvent.Captured(_, _, _) -> "Captured"
        PaymentEvent.Refunded(_, _, _) -> "Refunded"

verify eventName
    eventName(PaymentEvent.Authorized(100, "USD", "2026-03-10T09:00:00Z")) => "Authorized"
    eventName(PaymentEvent.Captured(100, "USD", "2026-03-10T10:00:00Z")) => "Captured"
    eventName(PaymentEvent.Refunded(50, "USD", "2026-03-10T10:00:00Z")) => "Refunded"

fn eventAt(event: PaymentEvent) -> String
    ? "Timestamp carried by a canonical event."
    match event
        PaymentEvent.Authorized(_, _, at) -> at
        PaymentEvent.Captured(_, _, at) -> at
        PaymentEvent.Refunded(_, _, at) -> at

verify eventAt
    eventAt(PaymentEvent.Authorized(100, "USD", "2026-03-10T09:00:00Z")) => "2026-03-10T09:00:00Z"
    eventAt(PaymentEvent.Captured(100, "USD", "2026-03-10T10:00:00Z")) => "2026-03-10T10:00:00Z"
    eventAt(PaymentEvent.Refunded(50, "USD", "2026-03-10T11:00:00Z")) => "2026-03-10T11:00:00Z"

fn eventCurrency(event: PaymentEvent) -> String
    ? "Currency carried by a canonical event."
    match event
        PaymentEvent.Authorized(_, currency, _) -> currency
        PaymentEvent.Captured(_, currency, _) -> currency
        PaymentEvent.Refunded(_, currency, _) -> currency

verify eventCurrency
    eventCurrency(PaymentEvent.Authorized(50, "USD", "2026-03-10T09:00:00Z")) => "USD"
    eventCurrency(PaymentEvent.Captured(50, "GBP", "2026-03-10T10:00:00Z")) => "GBP"
    eventCurrency(PaymentEvent.Refunded(50, "EUR", "2026-03-10T10:00:00Z")) => "EUR"

fn eventAmount(event: PaymentEvent) -> Int
    ? "Amount carried by a canonical event."
    match event
        PaymentEvent.Authorized(amount, _, _) -> amount
        PaymentEvent.Captured(amount, _, _) -> amount
        PaymentEvent.Refunded(amount, _, _) -> amount

verify eventAmount
    eventAmount(PaymentEvent.Authorized(900, "USD", "2026-03-10T09:00:00Z")) => 900
    eventAmount(PaymentEvent.Captured(1200, "USD", "2026-03-10T10:00:00Z")) => 1200
    eventAmount(PaymentEvent.Refunded(200, "USD", "2026-03-10T11:00:00Z")) => 200

fn hasSourceId(events: List<PaymentEventRecord>, provider: String, sourceId: String) -> Bool
    ? "True when a webhook source ID was already persisted for a provider."
    match events
        [] -> false
        [entry, ..rest] -> match entry.provider == provider
            true -> match entry.sourceId == sourceId
                true -> true
                false -> hasSourceId(rest, provider, sourceId)
            false -> hasSourceId(rest, provider, sourceId)

verify hasSourceId
    hasSourceId([sampleAuthorized(), sampleCaptured()], "stripe", "evt-1") => true
    hasSourceId([sampleAuthorized()], "stripe", "missing") => false

fn nextSeq(events: List<PaymentEventRecord>, provider: String, paymentId: String) -> Int
    ? "Next event sequence number for one payment stream."
    nextSeqFrom(events, provider, paymentId, 1)

verify nextSeq
    nextSeq([], "stripe", "pay-1") => 1
    nextSeq([sampleAuthorized(), sampleCaptured()], "stripe", "pay-1") => 3
    nextSeq([sampleAuthorized(), sampleCaptured()], "stripe", "pay-2") => 1

fn nextSeqFrom(events: List<PaymentEventRecord>, provider: String, paymentId: String, current: Int) -> Int
    ? "Tail-recursive sequence scan."
    match events
        [] -> current
        [entry, ..rest] -> match samePayment(entry, provider, paymentId)
            true -> nextSeqFrom(rest, provider, paymentId, entry.seq + 1)
            false -> nextSeqFrom(rest, provider, paymentId, current)

verify nextSeqFrom
    nextSeqFrom([], "stripe", "pay-1", 4) => 4
    nextSeqFrom([sampleAuthorized()], "stripe", "pay-1", 1) => 2

fn eventsForPayment(events: List<PaymentEventRecord>, paymentId: String) -> List<PaymentEventRecord>
    ? "Filters the append-only log down to one payment stream."
    List.reverse(eventsForPaymentInto(events, paymentId, []))

verify eventsForPayment
    eventsForPayment([sampleAuthorized(), sampleCaptured(), sampleOtherPayment()], "pay-1") => [sampleAuthorized(), sampleCaptured()]

fn eventsForPaymentInto(events: List<PaymentEventRecord>, paymentId: String, kept: List<PaymentEventRecord>) -> List<PaymentEventRecord>
    ? "Tail-recursive payment filter."
    match events
        [] -> kept
        [entry, ..rest] -> match entry.paymentId == paymentId
            true -> eventsForPaymentInto(rest, paymentId, List.prepend(entry, kept))
            false -> eventsForPaymentInto(rest, paymentId, kept)

verify eventsForPaymentInto
    eventsForPaymentInto([], "pay-1", [sampleAuthorized()]) => [sampleAuthorized()]

fn replayPayment(events: List<PaymentEventRecord>) -> Result<PaymentState, String>
    ? "Rebuilds one payment state from its event stream."
    match events
        [] -> Result.Err("Cannot replay empty payment event list")
        [first, ..rest] -> Result.Ok(replayPaymentFrom(rest, applyEvent(emptyState(first), first)))

verify replayPayment
    replayPayment([sampleAuthorized(), sampleCaptured()]) => Result.Ok(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = [], anomalyNotes = []))
    replayPayment([sampleRefundBeforeCapture()]) => Result.Ok(PaymentState(paymentId = "pay-2", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 400, latestAt = "2026-03-10T11:00:00Z", anomalyKeys = ["refund-before-capture:evt-9", "refund-exceeds-capture:evt-9"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-2'", "Refunded amount exceeds captured amount for payment 'pay-2'"]))
    replayPayment([]) => Result.Err("Cannot replay empty payment event list")
    replayPayment([sampleAuthorized(), sampleRefundInOtherCurrency()]) => Result.Ok(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["currency-mismatch:evt-5"], anomalyNotes = ["Refunded event on payment 'pay-1' used currency EUR while the payment is in USD; amount 200 not added to refunded total"]))

fn replayPaymentFrom(events: List<PaymentEventRecord>, state: PaymentState) -> PaymentState
    ? "Tail-recursive fold over one payment stream."
    match events
        [] -> state
        [entry, ..rest] -> replayPaymentFrom(rest, applyEvent(state, entry))

verify replayPaymentFrom
    replayPaymentFrom([], emptyState(sampleAuthorized())) => emptyState(sampleAuthorized())

fn replayAll(events: List<PaymentEventRecord>) -> List<PaymentState>
    ? "Replays the whole event log into one state per payment."
    List.reverse(replayAllInto(events, []))

verify replayAll
    replayAll([sampleAuthorized(), sampleCaptured(), sampleOtherPayment()]) => [PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = [], anomalyNotes = []), PaymentState(paymentId = "pay-2", provider = "stripe", currency = "EUR", authorizedAmount = 700, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T12:00:00Z", anomalyKeys = [], anomalyNotes = [])]

fn replayAllInto(events: List<PaymentEventRecord>, states: List<PaymentState>) -> List<PaymentState>
    ? "Incrementally updates one payment state list while scanning the log."
    match events
        [] -> states
        [entry, ..rest] -> replayAllInto(rest, upsertState(states, entry))

verify replayAllInto
    replayAllInto([], [emptyState(sampleAuthorized())]) => [emptyState(sampleAuthorized())]

fn upsertState(states: List<PaymentState>, entry: PaymentEventRecord) -> List<PaymentState>
    ? "Applies one event to the matching state or creates a new one."
    match findState(states, entry.provider, entry.paymentId)
        Option.None -> List.prepend(applyEvent(emptyState(entry), entry), states)
        Option.Some(state) -> replaceState(states, applyEvent(state, entry))

verify upsertState
    upsertState([], sampleAuthorized()) => [applyEvent(emptyState(sampleAuthorized()), sampleAuthorized())]

fn findState(states: List<PaymentState>, provider: String, paymentId: String) -> Option<PaymentState>
    ? "Looks up one payment state inside the replay accumulator."
    match states
        [] -> Option.None
        [state, ..rest] -> match state.provider == provider
            true -> match state.paymentId == paymentId
                true -> Option.Some(state)
                false -> findState(rest, provider, paymentId)
            false -> findState(rest, provider, paymentId)

verify findState
    findState([emptyState(sampleAuthorized())], "stripe", "pay-1") => Option.Some(emptyState(sampleAuthorized()))
    findState([], "stripe", "pay-1") => Option.None

fn replaceState(states: List<PaymentState>, updated: PaymentState) -> List<PaymentState>
    ? "Replaces one payment state in the replay accumulator."
    replaceStateInto(states, updated, [])

verify replaceState
    replaceState([emptyState(sampleAuthorized())], applyEvent(emptyState(sampleAuthorized()), sampleAuthorized())) => [applyEvent(emptyState(sampleAuthorized()), sampleAuthorized())]

fn replaceStateInto(states: List<PaymentState>, updated: PaymentState, acc: List<PaymentState>) -> List<PaymentState>
    ? "Tail-recursive helper for replay state replacement."
    match states
        [] -> List.reverse(acc)
        [state, ..rest] -> match state.provider == updated.provider
            true -> match state.paymentId == updated.paymentId
                true -> List.concat(List.reverse(List.prepend(updated, acc)), rest)
                false -> replaceStateInto(rest, updated, List.prepend(state, acc))
            false -> replaceStateInto(rest, updated, List.prepend(state, acc))

verify replaceStateInto
    replaceStateInto([], emptyState(sampleAuthorized()), [emptyState(sampleAuthorized())]) => [emptyState(sampleAuthorized())]

fn emptyState(entry: PaymentEventRecord) -> PaymentState
    ? "Zero-value state seeded with the first event's currency as the canonical one."
    PaymentState(paymentId = entry.paymentId, provider = entry.provider, currency = eventCurrency(entry.event), authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = eventAt(entry.event), anomalyKeys = [], anomalyNotes = [])

verify emptyState
    emptyState(sampleAuthorized()) => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])

fn applyEvent(state: PaymentState, entry: PaymentEventRecord) -> PaymentState
    ? "Applies one canonical event. Amounts are only added when the event currency matches"
      "the payment's canonical currency; mismatches become anomalies and leave totals alone."
    match entry.event
        PaymentEvent.Authorized(amount, currency, at) -> applyAuthorized(state, entry.sourceId, amount, currency, at)
        PaymentEvent.Captured(amount, currency, at) -> applyCaptured(state, entry.sourceId, amount, currency, at)
        PaymentEvent.Refunded(amount, currency, at) -> applyRefunded(state, entry.sourceId, amount, currency, at)

verify applyEvent
    applyEvent(emptyState(sampleAuthorized()), sampleAuthorized()) => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])

fn applyAuthorized(state: PaymentState, sourceId: String, amount: Int, currency: String, at: String) -> PaymentState
    ? "Authorization updates the highest authorized total only when the currency matches."
      "An off-currency authorization is recorded as an anomaly without touching the total."
    match sameCurrency(state, currency)
        false -> addCurrencyAnomaly(PaymentState.update(state, latestAt = at), sourceId, "Authorized", amount, currency, "authorized")
        true -> PaymentState.update(state, authorizedAmount = Int.max(state.authorizedAmount, amount), latestAt = at)

verify applyAuthorized
    applyAuthorized(emptyState(sampleAuthorized()), "evt-1", 1000, "USD", "2026-03-10T09:00:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])
    applyAuthorized(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = []), "evt-9", 900, "EUR", "2026-03-10T09:30:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:30:00Z", anomalyKeys = ["currency-mismatch:evt-9"], anomalyNotes = ["Authorized event on payment 'pay-1' used currency EUR while the payment is in USD; amount 900 not added to authorized total"])

fn applyCaptured(state: PaymentState, sourceId: String, amount: Int, currency: String, at: String) -> PaymentState
    ? "Capture increases the captured total only when the currency matches the payment's."
      "An off-currency capture is recorded as an anomaly and excluded from the total."
    match sameCurrency(state, currency)
        false -> addCurrencyAnomaly(PaymentState.update(state, latestAt = at), sourceId, "Captured", amount, currency, "captured")
        true -> applyCapturedSameCurrency(state, sourceId, amount, at)

verify applyCaptured
    applyCaptured(emptyState(sampleAuthorized()), "evt-2", 1000, "USD", "2026-03-10T09:05:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = ["capture-without-authorize:evt-2"], anomalyNotes = ["Capture arrived before any authorization for payment 'pay-1'"])
    applyCaptured(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = []), "evt-7", 950, "EUR", "2026-03-10T09:05:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = ["currency-mismatch:evt-7"], anomalyNotes = ["Captured event on payment 'pay-1' used currency EUR while the payment is in USD; amount 950 not added to captured total"])

fn applyCapturedSameCurrency(state: PaymentState, sourceId: String, amount: Int, at: String) -> PaymentState
    ? "Applies a same-currency capture and flags out-of-order or over-authorized totals."
    base = PaymentState.update(state, capturedAmount = state.capturedAmount + amount, latestAt = at)
    missingAuth = match state.authorizedAmount == 0
        true -> addAnomaly(base, "capture-without-authorize:{sourceId}", "Capture arrived before any authorization for payment '{state.paymentId}'")
        false -> base
    match missingAuth.authorizedAmount > 0
        true -> match missingAuth.capturedAmount > missingAuth.authorizedAmount
            true -> addAnomaly(missingAuth, "captured-exceeds-authorized:{sourceId}", "Captured amount exceeds authorized amount for payment '{state.paymentId}'")
            false -> missingAuth
        false -> missingAuth

verify applyCapturedSameCurrency
    applyCapturedSameCurrency(emptyState(sampleAuthorized()), "evt-2", 1000, "2026-03-10T09:05:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = ["capture-without-authorize:evt-2"], anomalyNotes = ["Capture arrived before any authorization for payment 'pay-1'"])

fn applyRefunded(state: PaymentState, sourceId: String, amount: Int, currency: String, at: String) -> PaymentState
    ? "Refund increases the refunded total only when the currency matches the payment's."
      "An off-currency refund is recorded as an anomaly and excluded from the total."
    match sameCurrency(state, currency)
        false -> addCurrencyAnomaly(PaymentState.update(state, latestAt = at), sourceId, "Refunded", amount, currency, "refunded")
        true -> applyRefundedSameCurrency(state, sourceId, amount, at)

verify applyRefunded
    applyRefunded(emptyState(sampleAuthorized()), "evt-3", 200, "USD", "2026-03-10T10:00:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 200, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["refund-before-capture:evt-3", "refund-exceeds-capture:evt-3"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-1'", "Refunded amount exceeds captured amount for payment 'pay-1'"])
    applyRefunded(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = [], anomalyNotes = []), "evt-8", 200, "EUR", "2026-03-10T10:00:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["currency-mismatch:evt-8"], anomalyNotes = ["Refunded event on payment 'pay-1' used currency EUR while the payment is in USD; amount 200 not added to refunded total"])

fn applyRefundedSameCurrency(state: PaymentState, sourceId: String, amount: Int, at: String) -> PaymentState
    ? "Applies a same-currency refund and flags order or total mismatches."
    base = PaymentState.update(state, refundedAmount = state.refundedAmount + amount, latestAt = at)
    missingCapture = match state.capturedAmount == 0
        true -> addAnomaly(base, "refund-before-capture:{sourceId}", "Refund arrived before any capture for payment '{state.paymentId}'")
        false -> base
    match missingCapture.refundedAmount > missingCapture.capturedAmount
        true -> addAnomaly(missingCapture, "refund-exceeds-capture:{sourceId}", "Refunded amount exceeds captured amount for payment '{state.paymentId}'")
        false -> missingCapture

verify applyRefundedSameCurrency
    applyRefundedSameCurrency(emptyState(sampleAuthorized()), "evt-3", 200, "2026-03-10T10:00:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 200, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["refund-before-capture:evt-3", "refund-exceeds-capture:evt-3"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-1'", "Refunded amount exceeds captured amount for payment 'pay-1'"])

fn sameCurrency(state: PaymentState, currency: String) -> Bool
    ? "True when the event currency matches the payment's canonical currency."
    state.currency == currency

verify sameCurrency
    sameCurrency(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = []), "USD") => true
    sameCurrency(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = []), "EUR") => false

fn addCurrencyAnomaly(state: PaymentState, sourceId: String, eventLabel: String, amount: Int, eventCurrency: String, totalLabel: String) -> PaymentState
    ? "Records an off-currency event as an anomaly and keeps the totals untouched."
    addAnomaly(state, "currency-mismatch:{sourceId}", "{eventLabel} event on payment '{state.paymentId}' used currency {eventCurrency} while the payment is in {state.currency}; amount {Int.toString(amount)} not added to {totalLabel} total")

verify addCurrencyAnomaly
    addCurrencyAnomaly(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = []), "evt-9", "Refunded", 200, "EUR", "refunded") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = ["currency-mismatch:evt-9"], anomalyNotes = ["Refunded event on payment 'pay-1' used currency EUR while the payment is in USD; amount 200 not added to refunded total"])

fn addAnomaly(state: PaymentState, key: String, note: String) -> PaymentState
    ? "Appends a new anomaly marker in replay order."
    PaymentState.update(state, anomalyKeys = List.concat(state.anomalyKeys, [key]), anomalyNotes = List.concat(state.anomalyNotes, [note]))

verify addAnomaly
    addAnomaly(emptyState(sampleAuthorized()), "k", "n") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = ["k"], anomalyNotes = ["n"])

fn samePayment(entry: PaymentEventRecord, provider: String, paymentId: String) -> Bool
    ? "Exact stream identity check."
    match entry.provider == provider
        true -> entry.paymentId == paymentId
        false -> false

verify samePayment
    samePayment(sampleAuthorized(), "stripe", "pay-1") => true
    samePayment(sampleAuthorized(), "stripe", "other") => false

fn sampleAuthorized() -> PaymentEventRecord
    ? "Reusable replay fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-1", paymentId = "pay-1", seq = 1, event = PaymentEvent.Authorized(1000, "USD", "2026-03-10T09:00:00Z"))

verify sampleAuthorized
    sampleAuthorized() => PaymentEventRecord(provider = "stripe", sourceId = "evt-1", paymentId = "pay-1", seq = 1, event = PaymentEvent.Authorized(1000, "USD", "2026-03-10T09:00:00Z"))

fn sampleCaptured() -> PaymentEventRecord
    ? "Reusable replay fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-2", paymentId = "pay-1", seq = 2, event = PaymentEvent.Captured(1000, "USD", "2026-03-10T09:05:00Z"))

verify sampleCaptured
    sampleCaptured() => PaymentEventRecord(provider = "stripe", sourceId = "evt-2", paymentId = "pay-1", seq = 2, event = PaymentEvent.Captured(1000, "USD", "2026-03-10T09:05:00Z"))

fn sampleRefundBeforeCapture() -> PaymentEventRecord
    ? "Reusable anomaly fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-9", paymentId = "pay-2", seq = 1, event = PaymentEvent.Refunded(400, "USD", "2026-03-10T11:00:00Z"))

verify sampleRefundBeforeCapture
    sampleRefundBeforeCapture() => PaymentEventRecord(provider = "stripe", sourceId = "evt-9", paymentId = "pay-2", seq = 1, event = PaymentEvent.Refunded(400, "USD", "2026-03-10T11:00:00Z"))

fn sampleOtherPayment() -> PaymentEventRecord
    ? "Reusable multi-payment fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-7", paymentId = "pay-2", seq = 1, event = PaymentEvent.Authorized(700, "EUR", "2026-03-10T12:00:00Z"))

verify sampleOtherPayment
    sampleOtherPayment() => PaymentEventRecord(provider = "stripe", sourceId = "evt-7", paymentId = "pay-2", seq = 1, event = PaymentEvent.Authorized(700, "EUR", "2026-03-10T12:00:00Z"))

fn sampleRefundInOtherCurrency() -> PaymentEventRecord
    ? "Multi-currency fixture: a refund in EUR on a payment authorized in USD."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-5", paymentId = "pay-1", seq = 2, event = PaymentEvent.Refunded(200, "EUR", "2026-03-10T10:00:00Z"))

verify sampleRefundInOtherCurrency
    sampleRefundInOtherCurrency() => PaymentEventRecord(provider = "stripe", sourceId = "evt-5", paymentId = "pay-1", seq = 2, event = PaymentEvent.Refunded(200, "EUR", "2026-03-10T10:00:00Z"))
