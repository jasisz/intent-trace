module Cases
    intent =
        "Manual-review case generation and lifecycle management."
        "Dirty payment operations need stable case keys so re-running ingest or reconciliation"
        "does not keep opening the same human task forever."
        "Each case carries an explicit priority derived from its kind and amount so operators"
        "can tell a small duplicate refund apart from a large reconciliation break, and can"
        "re-prioritize or override priority manually when they resolve the case."
    exposes [makeCaseDraft, draftsFromStates, statusText, parseStatus, priorityText, parsePriority, priorityRank, priorityFor, materializeNewCases, resolveCase, reprioritizeCase, filterByStatusLabel, openCasesForPayment, findCaseById, auditForOpenedCase, auditForResolvedCase, auditForReprioritizedCase]
    depends [Types]

decision ManualReviewInsteadOfSilentFixup
    date = "2026-03-12"
    author = "Codex"
    reason =
        "Backoffice systems should not silently fix suspicious payment histories."
        "Opening explicit manual-review cases keeps the risk visible and auditable."
    chosen = "OpenCases"
    rejected = ["SilentRepair", "LogOnlyWarnings"]
    impacts = [draftsFromState, materializeNewCases, resolveCase]

decision DerivedPriorityWithManualOverride
    date = "2026-04-16"
    author = "Codex"
    reason =
        "Every manual-review case looked the same to operators, so a $50 duplicate refund"
        "competed for attention with a $500k reconciliation break."
        "Deriving priority from case kind and amount gives a safe default without removing"
        "human judgement: operators can still override priority during resolution or with an"
        "explicit reprioritize call, and the audit trail records the chosen priority."
    chosen = "DerivedPriorityWithOverride"
    rejected = ["NoPriority", "OperatorOnlyPriority", "AmountOnlyPriority"]
    impacts = [priorityFor, makeCaseDraft, draftFromPair, resolveCase, reprioritizeCase, auditForResolvedCase, auditForReprioritizedCase]

fn makeCaseDraft(provider: String, paymentId: String, kind: String, detail: String, key: String, amount: Int, priority: CasePriority) -> CaseDraft
    ? "Convenience constructor for reconcile and replay anomalies; priority is derived by the caller."
    CaseDraft(key = key, provider = provider, paymentId = paymentId, kind = kind, detail = detail, amount = amount, priority = priority)

verify makeCaseDraft
    makeCaseDraft("stripe", "pay-1", "refund_before_capture", "Refund arrived first", "k", 100, CasePriority.Normal) => CaseDraft(key = "k", provider = "stripe", paymentId = "pay-1", kind = "refund_before_capture", detail = "Refund arrived first", amount = 100, priority = CasePriority.Normal)

fn draftsFromState(state: PaymentState) -> List<CaseDraft>
    ? "Turns replay anomalies into manual-review drafts with a derived priority."
    draftsFromPairs(state, state.anomalyKeys, state.anomalyNotes)

verify draftsFromState
    draftsFromState(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 100, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["refund-before-capture:evt-1"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-1'"])) => [CaseDraft(key = "refund-before-capture:evt-1", provider = "stripe", paymentId = "pay-1", kind = "refund_before_capture", detail = "Refund arrived before any capture for payment 'pay-1'", amount = 100, priority = CasePriority.Low)]

fn draftsFromStates(states: List<PaymentState>) -> List<CaseDraft>
    ? "Flattens replay anomalies from every payment state."
    List.reverse(draftsFromStatesInto(states, []))

verify draftsFromStates
    draftsFromStates([PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 100, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["refund-before-capture:evt-1"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-1'"])]) => [CaseDraft(key = "refund-before-capture:evt-1", provider = "stripe", paymentId = "pay-1", kind = "refund_before_capture", detail = "Refund arrived before any capture for payment 'pay-1'", amount = 100, priority = CasePriority.Low)]

fn draftsFromStatesInto(states: List<PaymentState>, acc: List<CaseDraft>) -> List<CaseDraft>
    ? "Tail-recursive case flattening."
    match states
        [] -> acc
        [state, ..rest] -> draftsFromStatesInto(rest, prependAll(draftsFromState(state), acc))

verify draftsFromStatesInto
    draftsFromStatesInto([], []) => []

fn draftsFromPairs(state: PaymentState, keys: List<String>, notes: List<String>) -> List<CaseDraft>
    ? "Zips anomaly keys and notes into review cases."
    List.reverse(draftsFromPairsInto(state, keys, notes, []))

verify draftsFromPairs
    draftsFromPairs(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 100, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = [], anomalyNotes = []), ["capture-without-authorize:evt-1"], ["Capture arrived before any authorization for payment 'pay-1'"]) => [CaseDraft(key = "capture-without-authorize:evt-1", provider = "stripe", paymentId = "pay-1", kind = "capture_without_authorize", detail = "Capture arrived before any authorization for payment 'pay-1'", amount = 0, priority = CasePriority.Low)]

fn draftsFromPairsInto(state: PaymentState, keys: List<String>, notes: List<String>, acc: List<CaseDraft>) -> List<CaseDraft>
    ? "Tail-recursive anomaly zip for review drafts."
    match keys
        [] -> acc
        [key, ..restKeys] -> draftsFromPairsInto(state, restKeys, tail(notes), List.prepend(draftFromPair(state, key, Option.withDefault(Vector.get(Vector.fromList(notes), 0), "Suspicious payment history")), acc))

verify draftsFromPairsInto
    draftsFromPairsInto(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 100, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = [], anomalyNotes = []), [], [], [makeCaseDraft("stripe", "pay-1", "x", "d", "k", 0, CasePriority.Normal)]) => [makeCaseDraft("stripe", "pay-1", "x", "d", "k", 0, CasePriority.Normal)]

fn draftFromPair(state: PaymentState, key: String, note: String) -> CaseDraft
    ? "Builds one case draft from a replay anomaly with priority derived from kind and amount."
    kind = kindFromKey(key)
    amount = amountForReplayKind(state, kind)
    makeCaseDraft(state.provider, state.paymentId, kind, note, key, amount, priorityFor(kind, amount))

verify draftFromPair
    draftFromPair(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 100, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = [], anomalyNotes = []), "capture-without-authorize:evt-1", "Capture arrived before any authorization for payment 'pay-1'") => CaseDraft(key = "capture-without-authorize:evt-1", provider = "stripe", paymentId = "pay-1", kind = "capture_without_authorize", detail = "Capture arrived before any authorization for payment 'pay-1'", amount = 0, priority = CasePriority.Low)

fn amountForReplayKind(state: PaymentState, kind: String) -> Int
    ? "Picks the most relevant monetary amount from a replayed state for a given case kind."
    fallback = Int.max(state.capturedAmount, Int.max(state.refundedAmount, state.authorizedAmount))
    match kind
        "refund_before_capture" -> state.refundedAmount
        "refund_exceeds_capture" -> state.refundedAmount
        "capture_without_authorize" -> state.capturedAmount
        "captured_exceeds_authorized" -> state.capturedAmount
        "currency_mismatch" -> fallback
        _ -> fallback

verify amountForReplayKind
    amountForReplayKind(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 250, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = [], anomalyNotes = []), "refund_before_capture") => 250
    amountForReplayKind(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 800, refundedAmount = 0, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = [], anomalyNotes = []), "capture_without_authorize") => 800
    amountForReplayKind(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 100, capturedAmount = 200, refundedAmount = 300, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = [], anomalyNotes = []), "payment_integrity") => 300

fn priorityFor(kind: String, amount: Int) -> CasePriority
    ? "Derives a case priority from its kind and amount; large amounts escalate to Urgent and structural integrity breaks default to High."
    match amount >= 100000
        true -> CasePriority.Urgent
        false -> match amount >= 10000
            true -> match kindIsHighSeverity(kind)
                true -> CasePriority.Urgent
                false -> CasePriority.High
            false -> match amount >= 1000
                true -> match kindIsHighSeverity(kind)
                    true -> CasePriority.High
                    false -> CasePriority.Normal
                false -> match kindIsLowSeverity(kind)
                    true -> CasePriority.Low
                    false -> CasePriority.Normal

verify priorityFor
    priorityFor("refund_before_capture", 50) => CasePriority.Low
    priorityFor("settlement_capture_mismatch", 500) => CasePriority.Normal
    priorityFor("settlement_capture_mismatch", 5000) => CasePriority.Normal
    priorityFor("refund_exceeds_capture", 2500) => CasePriority.High
    priorityFor("captured_exceeds_authorized", 15000) => CasePriority.Urgent
    priorityFor("settlement_without_realtime", 25000) => CasePriority.High
    priorityFor("settlement_capture_mismatch", 500000) => CasePriority.Urgent

fn kindIsHighSeverity(kind: String) -> Bool
    ? "Structural-integrity anomalies that compound risk at larger amounts."
    match kind
        "captured_exceeds_authorized" -> true
        "refund_exceeds_capture" -> true
        "settlement_without_realtime" -> false
        "settlement_currency_mismatch" -> true
        "currency_mismatch" -> true
        _ -> false

verify kindIsHighSeverity
    kindIsHighSeverity("captured_exceeds_authorized") => true
    kindIsHighSeverity("refund_exceeds_capture") => true
    kindIsHighSeverity("settlement_currency_mismatch") => true
    kindIsHighSeverity("currency_mismatch") => true
    kindIsHighSeverity("settlement_capture_mismatch") => false
    kindIsHighSeverity("refund_before_capture") => false

fn kindIsLowSeverity(kind: String) -> Bool
    ? "Routine ordering anomalies that usually explain themselves at small amounts."
    match kind
        "refund_before_capture" -> true
        "capture_without_authorize" -> true
        _ -> false

verify kindIsLowSeverity
    kindIsLowSeverity("refund_before_capture") => true
    kindIsLowSeverity("capture_without_authorize") => true
    kindIsLowSeverity("settlement_capture_mismatch") => false

fn kindFromKey(key: String) -> String
    ? "Normalizes anomaly key prefixes into user-facing case kinds."
    match String.startsWith(key, "refund-before-capture:")
        true -> "refund_before_capture"
        false -> match String.startsWith(key, "capture-without-authorize:")
            true -> "capture_without_authorize"
            false -> match String.startsWith(key, "captured-exceeds-authorized:")
                true -> "captured_exceeds_authorized"
                false -> match String.startsWith(key, "refund-exceeds-capture:")
                    true -> "refund_exceeds_capture"
                    false -> match String.startsWith(key, "currency-mismatch:")
                        true -> "currency_mismatch"
                        false -> "payment_integrity"

verify kindFromKey
    kindFromKey("refund-before-capture:evt-1") => "refund_before_capture"
    kindFromKey("x") => "payment_integrity"

fn tail(items: List<String>) -> List<String>
    ? "Drops the first list item."
    match items
        [] -> []
        [_head, ..rest] -> rest

verify tail
    tail(["a", "b"]) => ["b"]
    tail([]) => []

fn prependAll(items: List<CaseDraft>, acc: List<CaseDraft>) -> List<CaseDraft>
    ? "Prepends a whole list onto an accumulator."
    match items
        [] -> acc
        [item, ..rest] -> prependAll(rest, List.prepend(item, acc))

verify prependAll
    prependAll([makeCaseDraft("stripe", "pay-1", "x", "d", "k", 0, CasePriority.Normal)], []) => [makeCaseDraft("stripe", "pay-1", "x", "d", "k", 0, CasePriority.Normal)]

fn statusText(status: CaseStatus) -> String
    ? "Stable on-disk and CLI spelling for case status."
    match status
        CaseStatus.Open -> "open"
        CaseStatus.Resolved -> "resolved"

verify statusText
    statusText(CaseStatus.Open) => "open"
    statusText(CaseStatus.Resolved) => "resolved"

fn parseStatus(raw: String) -> Result<CaseStatus, String>
    ? "Parses one stored case status."
    match String.toLower(raw)
        "open" -> Result.Ok(CaseStatus.Open)
        "resolved" -> Result.Ok(CaseStatus.Resolved)
        _ -> Result.Err("Case status must be one of: open, resolved")

verify parseStatus
    parseStatus("open") => Result.Ok(CaseStatus.Open)
    parseStatus("resolved") => Result.Ok(CaseStatus.Resolved)
    parseStatus("x") => Result.Err("Case status must be one of: open, resolved")

fn priorityText(priority: CasePriority) -> String
    ? "Stable on-disk and CLI spelling for case priority."
    match priority
        CasePriority.Low -> "low"
        CasePriority.Normal -> "normal"
        CasePriority.High -> "high"
        CasePriority.Urgent -> "urgent"

verify priorityText
    priorityText(CasePriority.Low) => "low"
    priorityText(CasePriority.Normal) => "normal"
    priorityText(CasePriority.High) => "high"
    priorityText(CasePriority.Urgent) => "urgent"

fn parsePriority(raw: String) -> Result<CasePriority, String>
    ? "Parses one stored or CLI-provided case priority."
    match String.toLower(String.trim(raw))
        "low" -> Result.Ok(CasePriority.Low)
        "normal" -> Result.Ok(CasePriority.Normal)
        "high" -> Result.Ok(CasePriority.High)
        "urgent" -> Result.Ok(CasePriority.Urgent)
        _ -> Result.Err("Case priority must be one of: low, normal, high, urgent")

verify parsePriority
    parsePriority("Low") => Result.Ok(CasePriority.Low)
    parsePriority("urgent") => Result.Ok(CasePriority.Urgent)
    parsePriority("moderate") => Result.Err("Case priority must be one of: low, normal, high, urgent")

fn priorityRank(priority: CasePriority) -> Int
    ? "Sort key: Urgent first, Low last; downstream views sort by descending rank."
    match priority
        CasePriority.Urgent -> 3
        CasePriority.High -> 2
        CasePriority.Normal -> 1
        CasePriority.Low -> 0

verify priorityRank
    priorityRank(CasePriority.Urgent) => 3
    priorityRank(CasePriority.High) => 2
    priorityRank(CasePriority.Normal) => 1
    priorityRank(CasePriority.Low) => 0

fn materializeNewCases(existing: List<ReviewCase>, drafts: List<CaseDraft>, createdAt: String) -> List<ReviewCase>
    ? "Assigns deterministic case IDs and skips already-known case keys."
    List.reverse(materializeInto(existing, drafts, createdAt, List.len(existing) + 1, []))

verify materializeNewCases
    materializeNewCases([], [makeCaseDraft("stripe", "pay-1", "refund_before_capture", "Refund arrived first", "k", 100, CasePriority.Normal)], "2026-03-10T12:00:00Z") => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "refund_before_capture", detail = "Refund arrived first", amount = 100, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]
    materializeNewCases([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "refund_before_capture", detail = "Refund arrived first", amount = 100, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], [makeCaseDraft("stripe", "pay-1", "refund_before_capture", "Refund arrived first", "k", 100, CasePriority.Normal)], "2026-03-10T12:30:00Z") => []

fn materializeInto(existing: List<ReviewCase>, drafts: List<CaseDraft>, createdAt: String, nextId: Int, acc: List<ReviewCase>) -> List<ReviewCase>
    ? "Tail-recursive case materialization with dedupe; carries draft priority onto the persisted case."
    match drafts
        [] -> acc
        [draft, ..rest] -> match caseKeyExists(existing, draft.key)
            true -> materializeInto(existing, rest, createdAt, nextId, acc)
            false -> match caseKeyExists(acc, draft.key)
                true -> materializeInto(existing, rest, createdAt, nextId, acc)
                false -> materializeInto(existing, rest, createdAt, nextId + 1, List.prepend(ReviewCase(id = "case-{Int.toString(nextId)}", key = draft.key, provider = draft.provider, paymentId = draft.paymentId, kind = draft.kind, detail = draft.detail, amount = draft.amount, priority = draft.priority, status = CaseStatus.Open, createdAt = createdAt, resolvedAt = Option.None, resolution = Option.None), acc))

verify materializeInto
    materializeInto([], [], "2026-03-10T12:00:00Z", 2, []) => []

fn caseKeyExists(cases: List<ReviewCase>, key: String) -> Bool
    ? "True when any persisted case already owns the same stable key."
    match cases
        [] -> false
        [item, ..rest] -> match item.key == key
            true -> true
            false -> caseKeyExists(rest, key)

verify caseKeyExists
    caseKeyExists([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "k") => true
    caseKeyExists([], "k") => false

fn resolveCase(cases: List<ReviewCase>, caseId: String, resolution: String, resolvedAt: String, priorityOverride: Option<CasePriority>) -> Result<List<ReviewCase>, String>
    ? "Marks one case as resolved, preserving the priority it carried unless an override is supplied."
    match hasCaseId(cases, caseId)
        false -> Result.Err("Unknown case: " + caseId)
        true -> Result.Ok(resolveCaseInList(cases, caseId, resolution, resolvedAt, priorityOverride))

verify resolveCase
    resolveCase([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "case-1", "duplicate webhook", "2026-03-10T13:00:00Z", Option.None) => Result.Ok([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.Normal, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("duplicate webhook"))])
    resolveCase([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "case-1", "escalated by ops", "2026-03-10T13:00:00Z", Option.Some(CasePriority.Urgent)) => Result.Ok([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.Urgent, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("escalated by ops"))])
    resolveCase([], "case-1", "x", "2026-03-10T13:00:00Z", Option.None) => Result.Err("Unknown case: case-1")

fn hasCaseId(cases: List<ReviewCase>, caseId: String) -> Bool
    ? "Exact lookup by case ID."
    match cases
        [] -> false
        [item, ..rest] -> match item.id == caseId
            true -> true
            false -> hasCaseId(rest, caseId)

verify hasCaseId
    hasCaseId([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "case-1") => true
    hasCaseId([], "case-1") => false

fn resolveCaseInList(cases: List<ReviewCase>, caseId: String, resolution: String, resolvedAt: String, priorityOverride: Option<CasePriority>) -> List<ReviewCase>
    ? "Rewrites the case list with one resolved item."
    resolveCaseInto(cases, caseId, resolution, resolvedAt, priorityOverride, [])

verify resolveCaseInList
    resolveCaseInList([], "case-1", "x", "2026-03-10T13:00:00Z", Option.None) => []

fn resolveCaseInto(cases: List<ReviewCase>, caseId: String, resolution: String, resolvedAt: String, priorityOverride: Option<CasePriority>, acc: List<ReviewCase>) -> List<ReviewCase>
    ? "Tail-recursive list rewrite for case resolution; preserves priority unless override is supplied."
    match cases
        [] -> List.reverse(acc)
        [item, ..rest] -> match item.id == caseId
            true -> List.concat(List.reverse(List.prepend(ReviewCase(id = item.id, key = item.key, provider = item.provider, paymentId = item.paymentId, kind = item.kind, detail = item.detail, amount = item.amount, priority = Option.withDefault(priorityOverride, item.priority), status = CaseStatus.Resolved, createdAt = item.createdAt, resolvedAt = Option.Some(resolvedAt), resolution = Option.Some(resolution)), acc)), rest)
            false -> resolveCaseInto(rest, caseId, resolution, resolvedAt, priorityOverride, List.prepend(item, acc))

verify resolveCaseInto
    resolveCaseInto([], "case-1", "x", "2026-03-10T13:00:00Z", Option.None, [ReviewCase(id = "case-9", key = "k-9", provider = "stripe", paymentId = "pay-9", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]) => [ReviewCase(id = "case-9", key = "k-9", provider = "stripe", paymentId = "pay-9", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]

fn reprioritizeCase(cases: List<ReviewCase>, caseId: String, priority: CasePriority) -> Result<List<ReviewCase>, String>
    ? "Manually changes one case's priority without resolving it; used when operators triage."
    match hasCaseId(cases, caseId)
        false -> Result.Err("Unknown case: " + caseId)
        true -> Result.Ok(reprioritizeCaseInto(cases, caseId, priority, []))

verify reprioritizeCase
    reprioritizeCase([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "case-1", CasePriority.High) => Result.Ok([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.High, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)])
    reprioritizeCase([], "case-1", CasePriority.High) => Result.Err("Unknown case: case-1")

fn reprioritizeCaseInto(cases: List<ReviewCase>, caseId: String, priority: CasePriority, acc: List<ReviewCase>) -> List<ReviewCase>
    ? "Tail-recursive list rewrite for priority change."
    match cases
        [] -> List.reverse(acc)
        [item, ..rest] -> match item.id == caseId
            true -> List.concat(List.reverse(List.prepend(ReviewCase.update(item, priority = priority), acc)), rest)
            false -> reprioritizeCaseInto(rest, caseId, priority, List.prepend(item, acc))

verify reprioritizeCaseInto
    reprioritizeCaseInto([], "case-1", CasePriority.High, [ReviewCase(id = "case-9", key = "k", provider = "stripe", paymentId = "pay-9", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]) => [ReviewCase(id = "case-9", key = "k", provider = "stripe", paymentId = "pay-9", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]

fn filterByStatusLabel(cases: List<ReviewCase>, status: Option<String>) -> Result<List<ReviewCase>, String>
    ? "Supports list_cases open|resolved|all with open as the default."
    match status
        Option.None -> Result.Ok(filterOpen(cases))
        Option.Some(label) -> match String.toLower(label)
            "open" -> Result.Ok(filterOpen(cases))
            "resolved" -> Result.Ok(filterResolved(cases))
            "all" -> Result.Ok(cases)
            _ -> Result.Err("Case filter must be one of: open, resolved, all")

verify filterByStatusLabel
    filterByStatusLabel([], Option.None) => Result.Ok([])
    filterByStatusLabel([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], Option.Some("open")) => Result.Ok([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)])
    filterByStatusLabel([], Option.Some("weird")) => Result.Err("Case filter must be one of: open, resolved, all")

fn filterOpen(cases: List<ReviewCase>) -> List<ReviewCase>
    ? "Keeps only open cases."
    List.reverse(filterOpenInto(cases, []))

verify filterOpen
    filterOpen([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]) => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]

fn filterOpenInto(cases: List<ReviewCase>, acc: List<ReviewCase>) -> List<ReviewCase>
    ? "Tail-recursive open-case filter."
    match cases
        [] -> acc
        [item, ..rest] -> match item.status
            CaseStatus.Open -> filterOpenInto(rest, List.prepend(item, acc))
            CaseStatus.Resolved -> filterOpenInto(rest, acc)

verify filterOpenInto
    filterOpenInto([], [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]) => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]

fn filterResolved(cases: List<ReviewCase>) -> List<ReviewCase>
    ? "Keeps only resolved cases."
    List.reverse(filterResolvedInto(cases, []))

verify filterResolved
    filterResolved([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("done"))]) => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("done"))]

fn filterResolvedInto(cases: List<ReviewCase>, acc: List<ReviewCase>) -> List<ReviewCase>
    ? "Tail-recursive resolved-case filter."
    match cases
        [] -> acc
        [item, ..rest] -> match item.status
            CaseStatus.Open -> filterResolvedInto(rest, acc)
            CaseStatus.Resolved -> filterResolvedInto(rest, List.prepend(item, acc))

verify filterResolvedInto
    filterResolvedInto([], [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("done"))]) => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("done"))]

fn openCasesForPayment(cases: List<ReviewCase>, paymentId: String) -> List<ReviewCase>
    ? "Keeps only open cases for one payment."
    List.reverse(openCasesForPaymentInto(cases, paymentId, []))

verify openCasesForPayment
    openCasesForPayment([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "pay-1") => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]

fn openCasesForPaymentInto(cases: List<ReviewCase>, paymentId: String, acc: List<ReviewCase>) -> List<ReviewCase>
    ? "Tail-recursive payment-scoped open-case filter."
    match cases
        [] -> acc
        [item, ..rest] -> match item.paymentId == paymentId
            true -> match item.status
                CaseStatus.Open -> openCasesForPaymentInto(rest, paymentId, List.prepend(item, acc))
                CaseStatus.Resolved -> openCasesForPaymentInto(rest, paymentId, acc)
            false -> openCasesForPaymentInto(rest, paymentId, acc)

verify openCasesForPaymentInto
    openCasesForPaymentInto([], "pay-1", [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]) => [ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)]

fn findCaseById(cases: List<ReviewCase>, caseId: String) -> Option<ReviewCase>
    ? "Convenience lookup after mutation."
    match cases
        [] -> Option.None
        [item, ..rest] -> match item.id == caseId
            true -> Option.Some(item)
            false -> findCaseById(rest, caseId)

verify findCaseById
    findCaseById([ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)], "case-1") => Option.Some(ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Normal, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None))
    findCaseById([], "case-1") => Option.None

fn auditForOpenedCase(item: ReviewCase) -> AuditEntry
    ? "Stable audit entry for new manual-review work; records the initial priority."
    AuditEntry(key = "case-opened:{item.key}", subjectId = "payment:{item.paymentId}", action = "case.opened", message = "[{priorityText(item.priority)}][{item.kind}] {item.detail}", createdAt = item.createdAt)

verify auditForOpenedCase
    auditForOpenedCase(ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 0, priority = CasePriority.Urgent, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None)) => AuditEntry(key = "case-opened:k", subjectId = "payment:pay-1", action = "case.opened", message = "[urgent][x] d", createdAt = "2026-03-10T12:00:00Z")

fn auditForResolvedCase(item: ReviewCase) -> AuditEntry
    ? "Stable audit entry for manual resolution; preserves the priority the case was resolved at."
    resolutionMessage = Option.withDefault(item.resolution, "resolved")
    AuditEntry(key = "case-resolved:{item.key}", subjectId = "payment:{item.paymentId}", action = "case.resolved", message = "[{priorityText(item.priority)}] {resolutionMessage}", createdAt = Option.withDefault(item.resolvedAt, item.createdAt))

verify auditForResolvedCase
    auditForResolvedCase(ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.Urgent, status = CaseStatus.Resolved, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.Some("2026-03-10T13:00:00Z"), resolution = Option.Some("duplicate"))) => AuditEntry(key = "case-resolved:k", subjectId = "payment:pay-1", action = "case.resolved", message = "[urgent] duplicate", createdAt = "2026-03-10T13:00:00Z")

fn auditForReprioritizedCase(item: ReviewCase, at: String) -> AuditEntry
    ? "Stable audit entry for a manual priority change."
    AuditEntry(key = "case-reprioritized:{item.key}:{priorityText(item.priority)}", subjectId = "payment:{item.paymentId}", action = "case.reprioritized", message = "priority set to {priorityText(item.priority)}", createdAt = at)

verify auditForReprioritizedCase
    auditForReprioritizedCase(ReviewCase(id = "case-1", key = "k", provider = "stripe", paymentId = "pay-1", kind = "x", detail = "d", amount = 100, priority = CasePriority.High, status = CaseStatus.Open, createdAt = "2026-03-10T12:00:00Z", resolvedAt = Option.None, resolution = Option.None), "2026-03-10T13:30:00Z") => AuditEntry(key = "case-reprioritized:k:high", subjectId = "payment:pay-1", action = "case.reprioritized", message = "priority set to high", createdAt = "2026-03-10T13:30:00Z")
