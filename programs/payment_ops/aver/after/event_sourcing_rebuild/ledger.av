module Ledger
    intent =
        "Pure replay and dedupe helpers for the payment ledger."
        "Backoffice review gets easier when webhook ingestion becomes append-only events"
        "and every current state is rebuilt from those events by one pure rebuilder."
    exposes [eventName, eventAt, hasSourceId, nextSeq, eventsForPayment, rebuildPaymentState, replayPayment, replayAll]
    depends [Types]

decision SingleRebuilderAsSourceOfTruth
    date = "2026-04-16"
    author = "Codex"
    reason =
        "Derivation and event-application used to be interleaved in replayPayment, which made"
        "it easy for field-updating helpers to drift out of sync with the event log."
        "A single pure rebuildPaymentState is the only function that turns events into state,"
        "so every other ledger operation composes on top of it and replay experiments like"
        "'what if event X had never arrived?' become a filter plus one call."
    chosen = "RebuildPaymentStateAsSingleFold"
    rejected = ["IncrementalFieldUpdatesPerOperation", "CachedStateWithPatches"]
    impacts = [rebuildPaymentState, replayPayment, replayAll]

fn eventName(event: PaymentEvent) -> String
    ? "Stable display name for one canonical event."
    match event
        PaymentEvent.Authorized(_, _, _) -> "Authorized"
        PaymentEvent.Captured(_, _, _) -> "Captured"
        PaymentEvent.Refunded(_, _, _) -> "Refunded"

verify eventName
    eventName(PaymentEvent.Authorized(100, "USD", "2026-03-10T09:00:00Z")) => "Authorized"
    eventName(PaymentEvent.Captured(100, "USD", "2026-03-10T10:00:00Z")) => "Captured"
    eventName(PaymentEvent.Refunded(50, "USD", "2026-03-10T10:00:00Z")) => "Refunded"

fn eventAt(event: PaymentEvent) -> String
    ? "Timestamp carried by a canonical event."
    match event
        PaymentEvent.Authorized(_, _, at) -> at
        PaymentEvent.Captured(_, _, at) -> at
        PaymentEvent.Refunded(_, _, at) -> at

verify eventAt
    eventAt(PaymentEvent.Authorized(100, "USD", "2026-03-10T09:00:00Z")) => "2026-03-10T09:00:00Z"
    eventAt(PaymentEvent.Captured(100, "USD", "2026-03-10T10:00:00Z")) => "2026-03-10T10:00:00Z"
    eventAt(PaymentEvent.Refunded(50, "USD", "2026-03-10T11:00:00Z")) => "2026-03-10T11:00:00Z"

fn eventCurrency(event: PaymentEvent) -> String
    ? "Currency carried by a canonical event."
    match event
        PaymentEvent.Authorized(_, currency, _) -> currency
        PaymentEvent.Captured(_, currency, _) -> currency
        PaymentEvent.Refunded(_, currency, _) -> currency

verify eventCurrency
    eventCurrency(PaymentEvent.Authorized(50, "USD", "2026-03-10T09:00:00Z")) => "USD"
    eventCurrency(PaymentEvent.Captured(50, "GBP", "2026-03-10T10:00:00Z")) => "GBP"
    eventCurrency(PaymentEvent.Refunded(50, "EUR", "2026-03-10T10:00:00Z")) => "EUR"

fn eventAmount(event: PaymentEvent) -> Int
    ? "Amount carried by a canonical event."
    match event
        PaymentEvent.Authorized(amount, _, _) -> amount
        PaymentEvent.Captured(amount, _, _) -> amount
        PaymentEvent.Refunded(amount, _, _) -> amount

verify eventAmount
    eventAmount(PaymentEvent.Authorized(900, "USD", "2026-03-10T09:00:00Z")) => 900
    eventAmount(PaymentEvent.Captured(1200, "USD", "2026-03-10T10:00:00Z")) => 1200
    eventAmount(PaymentEvent.Refunded(200, "USD", "2026-03-10T11:00:00Z")) => 200

fn hasSourceId(events: List<PaymentEventRecord>, provider: String, sourceId: String) -> Bool
    ? "True when a webhook source ID was already persisted for a provider."
    match events
        [] -> false
        [entry, ..rest] -> match entry.provider == provider
            true -> match entry.sourceId == sourceId
                true -> true
                false -> hasSourceId(rest, provider, sourceId)
            false -> hasSourceId(rest, provider, sourceId)

verify hasSourceId
    hasSourceId([sampleAuthorized(), sampleCaptured()], "stripe", "evt-1") => true
    hasSourceId([sampleAuthorized()], "stripe", "missing") => false

fn nextSeq(events: List<PaymentEventRecord>, provider: String, paymentId: String) -> Int
    ? "Next event sequence number for one payment stream."
    nextSeqFrom(events, provider, paymentId, 1)

verify nextSeq
    nextSeq([], "stripe", "pay-1") => 1
    nextSeq([sampleAuthorized(), sampleCaptured()], "stripe", "pay-1") => 3
    nextSeq([sampleAuthorized(), sampleCaptured()], "stripe", "pay-2") => 1

fn nextSeqFrom(events: List<PaymentEventRecord>, provider: String, paymentId: String, current: Int) -> Int
    ? "Tail-recursive sequence scan."
    match events
        [] -> current
        [entry, ..rest] -> match samePayment(entry, provider, paymentId)
            true -> nextSeqFrom(rest, provider, paymentId, entry.seq + 1)
            false -> nextSeqFrom(rest, provider, paymentId, current)

verify nextSeqFrom
    nextSeqFrom([], "stripe", "pay-1", 4) => 4
    nextSeqFrom([sampleAuthorized()], "stripe", "pay-1", 1) => 2

fn eventsForPayment(events: List<PaymentEventRecord>, paymentId: String) -> List<PaymentEventRecord>
    ? "Filters the append-only log down to one payment stream."
    List.reverse(eventsForPaymentInto(events, paymentId, []))

verify eventsForPayment
    eventsForPayment([sampleAuthorized(), sampleCaptured(), sampleOtherPayment()], "pay-1") => [sampleAuthorized(), sampleCaptured()]

fn eventsForPaymentInto(events: List<PaymentEventRecord>, paymentId: String, kept: List<PaymentEventRecord>) -> List<PaymentEventRecord>
    ? "Tail-recursive payment filter."
    match events
        [] -> kept
        [entry, ..rest] -> match entry.paymentId == paymentId
            true -> eventsForPaymentInto(rest, paymentId, List.prepend(entry, kept))
            false -> eventsForPaymentInto(rest, paymentId, kept)

verify eventsForPaymentInto
    eventsForPaymentInto([], "pay-1", [sampleAuthorized()]) => [sampleAuthorized()]

fn rebuildPaymentState(events: List<PaymentEventRecord>) -> PaymentState
    ? "Sole source of truth: reconstructs the full payment state from scratch by folding over the given events in order. Replay experiments like 'what if event X had never arrived?' compose as a filter plus one call."
    match events
        [] -> emptyPaymentState()
        [first, ..rest] -> rebuildFrom(rest, applyEvent(seedState(first), first))

verify rebuildPaymentState
    rebuildPaymentState([]) => emptyPaymentState()
    rebuildPaymentState([sampleAuthorized(), sampleCaptured()]) => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = [], anomalyNotes = [])
    rebuildPaymentState([sampleRefundBeforeCapture()]) => PaymentState(paymentId = "pay-2", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 400, latestAt = "2026-03-10T11:00:00Z", anomalyKeys = ["refund-before-capture:evt-9", "refund-exceeds-capture:evt-9"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-2'", "Refunded amount exceeds captured amount for payment 'pay-2'"])

fn rebuildFrom(events: List<PaymentEventRecord>, state: PaymentState) -> PaymentState
    ? "Tail-recursive fold used by the rebuilder."
    match events
        [] -> state
        [entry, ..rest] -> rebuildFrom(rest, applyEvent(state, entry))

verify rebuildFrom
    rebuildFrom([], seedState(sampleAuthorized())) => seedState(sampleAuthorized())

fn replayPayment(events: List<PaymentEventRecord>) -> Result<PaymentState, String>
    ? "Thin wrapper over rebuildPaymentState that rejects the empty stream for callers that require at least one event."
    match events
        [] -> Result.Err("Cannot replay empty payment event list")
        _ -> Result.Ok(rebuildPaymentState(events))

verify replayPayment
    replayPayment([sampleAuthorized(), sampleCaptured()]) => Result.Ok(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = [], anomalyNotes = []))
    replayPayment([sampleRefundBeforeCapture()]) => Result.Ok(PaymentState(paymentId = "pay-2", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 400, latestAt = "2026-03-10T11:00:00Z", anomalyKeys = ["refund-before-capture:evt-9", "refund-exceeds-capture:evt-9"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-2'", "Refunded amount exceeds captured amount for payment 'pay-2'"]))
    replayPayment([]) => Result.Err("Cannot replay empty payment event list")

fn replayAll(events: List<PaymentEventRecord>) -> List<PaymentState>
    ? "Replays the whole event log by grouping per payment and invoking the single rebuilder on each stream."
    List.reverse(replayAllFor(paymentStreams(events, []), events, []))

verify replayAll
    replayAll([sampleAuthorized(), sampleCaptured(), sampleOtherPayment()]) => [PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = [], anomalyNotes = []), PaymentState(paymentId = "pay-2", provider = "stripe", currency = "EUR", authorizedAmount = 700, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T12:00:00Z", anomalyKeys = [], anomalyNotes = [])]
    replayAll([]) => []

fn replayAllFor(streams: List<PaymentStreamKey>, events: List<PaymentEventRecord>, acc: List<PaymentState>) -> List<PaymentState>
    ? "Tail-recursive fold over unique streams, each rebuilt by rebuildPaymentState."
    match streams
        [] -> acc
        [stream, ..rest] -> replayAllFor(rest, events, List.prepend(rebuildPaymentState(eventsForStream(events, stream, [])), acc))

verify replayAllFor
    replayAllFor([], [], []) => []

type PaymentStreamKey
    Stream(String, String)

fn paymentStreams(events: List<PaymentEventRecord>, acc: List<PaymentStreamKey>) -> List<PaymentStreamKey>
    ? "Collects unique (provider, paymentId) stream keys in first-seen order."
    match events
        [] -> List.reverse(acc)
        [entry, ..rest] -> match containsStream(acc, entry.provider, entry.paymentId)
            true -> paymentStreams(rest, acc)
            false -> paymentStreams(rest, List.prepend(PaymentStreamKey.Stream(entry.provider, entry.paymentId), acc))

verify paymentStreams
    paymentStreams([], []) => []
    paymentStreams([sampleAuthorized(), sampleCaptured()], []) => [PaymentStreamKey.Stream("stripe", "pay-1")]

fn containsStream(streams: List<PaymentStreamKey>, provider: String, paymentId: String) -> Bool
    ? "Stream membership test."
    match streams
        [] -> false
        [key, ..rest] -> match key
            PaymentStreamKey.Stream(p, id) -> match p == provider
                true -> match id == paymentId
                    true -> true
                    false -> containsStream(rest, provider, paymentId)
                false -> containsStream(rest, provider, paymentId)

verify containsStream
    containsStream([], "stripe", "pay-1") => false
    containsStream([PaymentStreamKey.Stream("stripe", "pay-1")], "stripe", "pay-1") => true
    containsStream([PaymentStreamKey.Stream("stripe", "pay-1")], "stripe", "pay-2") => false

fn eventsForStream(events: List<PaymentEventRecord>, stream: PaymentStreamKey, acc: List<PaymentEventRecord>) -> List<PaymentEventRecord>
    ? "Tail-recursive (provider, paymentId) filter used by replayAll."
    match events
        [] -> List.reverse(acc)
        [entry, ..rest] -> match stream
            PaymentStreamKey.Stream(provider, paymentId) -> match entry.provider == provider
                true -> match entry.paymentId == paymentId
                    true -> eventsForStream(rest, stream, List.prepend(entry, acc))
                    false -> eventsForStream(rest, stream, acc)
                false -> eventsForStream(rest, stream, acc)

verify eventsForStream
    eventsForStream([], PaymentStreamKey.Stream("stripe", "pay-1"), []) => []
    eventsForStream([sampleAuthorized(), sampleOtherPayment()], PaymentStreamKey.Stream("stripe", "pay-1"), []) => [sampleAuthorized()]

fn emptyPaymentState() -> PaymentState
    ? "Zero-value state used when the event stream is empty."
    PaymentState(paymentId = "", provider = "", currency = "", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "", anomalyKeys = [], anomalyNotes = [])

verify emptyPaymentState
    emptyPaymentState() => PaymentState(paymentId = "", provider = "", currency = "", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "", anomalyKeys = [], anomalyNotes = [])

fn seedState(entry: PaymentEventRecord) -> PaymentState
    ? "Zero-value state seeded from the first event identifiers."
    PaymentState(paymentId = entry.paymentId, provider = entry.provider, currency = eventCurrency(entry.event), authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = eventAt(entry.event), anomalyKeys = [], anomalyNotes = [])

verify seedState
    seedState(sampleAuthorized()) => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])

fn applyEvent(state: PaymentState, entry: PaymentEventRecord) -> PaymentState
    ? "Applies one canonical event and records suspicious transitions as anomalies."
    match entry.event
        PaymentEvent.Authorized(amount, currency, at) -> applyAuthorized(state, entry.sourceId, amount, currency, at)
        PaymentEvent.Captured(amount, currency, at) -> applyCaptured(state, entry.sourceId, amount, currency, at)
        PaymentEvent.Refunded(amount, currency, at) -> applyRefunded(state, entry.sourceId, amount, currency, at)

verify applyEvent
    applyEvent(seedState(sampleAuthorized()), sampleAuthorized()) => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])

fn applyAuthorized(state: PaymentState, sourceId: String, amount: Int, currency: String, at: String) -> PaymentState
    ? "Authorization stores the highest authorized amount seen so far."
    next = PaymentState.update(state, currency = currency, authorizedAmount = Int.max(state.authorizedAmount, amount), latestAt = at)
    withCurrencyCheck(next, sourceId, currency)

verify applyAuthorized
    applyAuthorized(seedState(sampleAuthorized()), "evt-1", 1000, "USD", "2026-03-10T09:00:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 1000, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])

fn applyCaptured(state: PaymentState, sourceId: String, amount: Int, currency: String, at: String) -> PaymentState
    ? "Capture increases the captured total and flags suspicious order or totals."
    base = withCurrencyCheck(PaymentState.update(state, currency = currency, capturedAmount = state.capturedAmount + amount, latestAt = at), sourceId, currency)
    missingAuth = match state.authorizedAmount == 0
        true -> addAnomaly(base, "capture-without-authorize:{sourceId}", "Capture arrived before any authorization for payment '{state.paymentId}'")
        false -> base
    match missingAuth.authorizedAmount > 0
        true -> match missingAuth.capturedAmount > missingAuth.authorizedAmount
            true -> addAnomaly(missingAuth, "captured-exceeds-authorized:{sourceId}", "Captured amount exceeds authorized amount for payment '{state.paymentId}'")
            false -> missingAuth
        false -> missingAuth

verify applyCaptured
    applyCaptured(seedState(sampleAuthorized()), "evt-2", 1000, "USD", "2026-03-10T09:05:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 1000, refundedAmount = 0, latestAt = "2026-03-10T09:05:00Z", anomalyKeys = ["capture-without-authorize:evt-2"], anomalyNotes = ["Capture arrived before any authorization for payment 'pay-1'"])

fn applyRefunded(state: PaymentState, sourceId: String, amount: Int, currency: String, at: String) -> PaymentState
    ? "Refund increases the refunded total and flags order or total mismatches."
    base = withCurrencyCheck(PaymentState.update(state, currency = currency, refundedAmount = state.refundedAmount + amount, latestAt = at), sourceId, currency)
    missingCapture = match state.capturedAmount == 0
        true -> addAnomaly(base, "refund-before-capture:{sourceId}", "Refund arrived before any capture for payment '{state.paymentId}'")
        false -> base
    match missingCapture.refundedAmount > missingCapture.capturedAmount
        true -> addAnomaly(missingCapture, "refund-exceeds-capture:{sourceId}", "Refunded amount exceeds captured amount for payment '{state.paymentId}'")
        false -> missingCapture

verify applyRefunded
    applyRefunded(seedState(sampleAuthorized()), "evt-3", 200, "USD", "2026-03-10T10:00:00Z") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 200, latestAt = "2026-03-10T10:00:00Z", anomalyKeys = ["refund-before-capture:evt-3", "refund-exceeds-capture:evt-3"], anomalyNotes = ["Refund arrived before any capture for payment 'pay-1'", "Refunded amount exceeds captured amount for payment 'pay-1'"])

fn withCurrencyCheck(state: PaymentState, sourceId: String, currency: String) -> PaymentState
    ? "Flags a currency switch after the first event."
    match state.currency == currency
        true -> state
        false -> addAnomaly(state, "currency-mismatch:{sourceId}", "Currency changed inside one payment stream '{state.paymentId}'")

verify withCurrencyCheck
    withCurrencyCheck(PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = []), "evt-9", "USD") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = [], anomalyNotes = [])

fn addAnomaly(state: PaymentState, key: String, note: String) -> PaymentState
    ? "Appends a new anomaly marker in replay order."
    PaymentState.update(state, anomalyKeys = List.concat(state.anomalyKeys, [key]), anomalyNotes = List.concat(state.anomalyNotes, [note]))

verify addAnomaly
    addAnomaly(seedState(sampleAuthorized()), "k", "n") => PaymentState(paymentId = "pay-1", provider = "stripe", currency = "USD", authorizedAmount = 0, capturedAmount = 0, refundedAmount = 0, latestAt = "2026-03-10T09:00:00Z", anomalyKeys = ["k"], anomalyNotes = ["n"])

fn samePayment(entry: PaymentEventRecord, provider: String, paymentId: String) -> Bool
    ? "Exact stream identity check."
    match entry.provider == provider
        true -> entry.paymentId == paymentId
        false -> false

verify samePayment
    samePayment(sampleAuthorized(), "stripe", "pay-1") => true
    samePayment(sampleAuthorized(), "stripe", "other") => false

fn sampleAuthorized() -> PaymentEventRecord
    ? "Reusable replay fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-1", paymentId = "pay-1", seq = 1, event = PaymentEvent.Authorized(1000, "USD", "2026-03-10T09:00:00Z"))

verify sampleAuthorized
    sampleAuthorized() => PaymentEventRecord(provider = "stripe", sourceId = "evt-1", paymentId = "pay-1", seq = 1, event = PaymentEvent.Authorized(1000, "USD", "2026-03-10T09:00:00Z"))

fn sampleCaptured() -> PaymentEventRecord
    ? "Reusable replay fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-2", paymentId = "pay-1", seq = 2, event = PaymentEvent.Captured(1000, "USD", "2026-03-10T09:05:00Z"))

verify sampleCaptured
    sampleCaptured() => PaymentEventRecord(provider = "stripe", sourceId = "evt-2", paymentId = "pay-1", seq = 2, event = PaymentEvent.Captured(1000, "USD", "2026-03-10T09:05:00Z"))

fn sampleRefundBeforeCapture() -> PaymentEventRecord
    ? "Reusable anomaly fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-9", paymentId = "pay-2", seq = 1, event = PaymentEvent.Refunded(400, "USD", "2026-03-10T11:00:00Z"))

verify sampleRefundBeforeCapture
    sampleRefundBeforeCapture() => PaymentEventRecord(provider = "stripe", sourceId = "evt-9", paymentId = "pay-2", seq = 1, event = PaymentEvent.Refunded(400, "USD", "2026-03-10T11:00:00Z"))

fn sampleOtherPayment() -> PaymentEventRecord
    ? "Reusable multi-payment fixture."
    PaymentEventRecord(provider = "stripe", sourceId = "evt-7", paymentId = "pay-2", seq = 1, event = PaymentEvent.Authorized(700, "EUR", "2026-03-10T12:00:00Z"))

verify sampleOtherPayment
    sampleOtherPayment() => PaymentEventRecord(provider = "stripe", sourceId = "evt-7", paymentId = "pay-2", seq = 1, event = PaymentEvent.Authorized(700, "EUR", "2026-03-10T12:00:00Z"))
