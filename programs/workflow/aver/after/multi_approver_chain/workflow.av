module Workflow
    intent =
        "Expense-report approval workflow. Each report moves through Draft → Submitted →"
        "(PartiallyApproved) → Approved or Rejected, and Approved reports can finally be"
        "Paid. Transitions are guarded: submitting requires non-empty title and positive"
        "amount; approval is gated by each approver's authority limit; large amounts"
        "require a chain of distinct approvers before reaching Approved; payment requires"
        "a prior approval. Every transition is recorded in an audit trail attached to the"
        "report."

decision StatesAsClosedVariant
    date = "2026-04-16"
    reason =
        "Expense reports have a small, fixed set of lifecycle states. Closing the variant"
        "lets the type-checker flag any future code path that forgets to handle one."
        "String-typed status fields would silently accept typos and new values."
    chosen = "SumTypeStatus"
    rejected = ["StringStatus", "IntCodeStatus"]
    impacts = [statusOf, submitReport, approveReport, rejectReport, payReport, isTerminal]

decision AuditTrailInline
    date = "2026-04-16"
    reason =
        "Callers routinely need to show who did what when. Storing events on the report"
        "keeps replay and explanation queries cheap. A separate audit store would force"
        "every consumer to join two sources."
    chosen = "InlineAuditLog"
    rejected = ["ExternalAuditStore", "NoAuditLog"]
    impacts = [submitReport, approveReport, rejectReport, payReport, eventsOf]

decision MultiApproverChainForLargeAmounts
    date = "2026-04-16"
    reason =
        "Reports above a policy threshold are too risky to clear with a single approver."
        "We add an intermediate PartiallyApproved state and track collected approver ids"
        "on the report itself. Each authorized approval appends to the list; the report"
        "only transitions to Approved once the required approver count is reached. Below"
        "the threshold the behaviour is unchanged — a single authorized approval wins."
        "Keeping the progress on the report (rather than in a side store) preserves the"
        "inline-audit property: replaying events and inspecting approvers needs one read."
        "Distinct approvers are required so a single user cannot fulfil the whole chain."
    chosen = "PartiallyApprovedWithApproverList"
    rejected = ["CounterOnly", "ParallelApprovalSet", "ExternalApprovalQueue"]
    impacts = [approveReport, approveFromSubmitted, approveFromPartial, requiredApprovers, isTerminal]

record Money
    cents: Int

record User
    id: String
    name: String
    approvalLimitCents: Int

type Status
    Draft
    Submitted
    PartiallyApproved
    Approved
    Rejected
    Paid

record Event
    timestampMs: Int
    actorId: String
    note: String

record Report
    id: String
    title: String
    amount: Money
    submitterId: String
    status: Status
    events: List<Event>
    approvals: List<String>

fn emptyReport(id: String, submitterId: String) -> Report
    ? "Creates a fresh Draft report with no title, zero amount, no events, and no approvals."
    Report(
        id = id,
        title = "",
        amount = Money(cents = 0),
        submitterId = submitterId,
        status = Status.Draft,
        events = [],
        approvals = []
    )

fn statusOf(r: Report) -> Status
    ? "Returns the current status of the report."
    r.status

verify statusOf
    statusOf(emptyReport("R1", "U1")) => Status.Draft
    statusOf(sampleSubmitted("R1", "U1")) => Status.Submitted
    statusOf(reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"])) => Status.PartiallyApproved
    statusOf(applyApproveFinal(sampleSubmitted("R1", "U1"), testUser("A1", 100000), 3000)) => Status.Approved
    statusOf(applyReject(sampleSubmitted("R1", "U1"), "M", "no", 3000)) => Status.Rejected
    statusOf(applyPay(sampleSubmitted("R1", "U1"), "U1", 4000)) => Status.Paid

fn eventsOf(r: Report) -> List<Event>
    ? "Returns the audit trail events in chronological order (oldest first)."
    List.reverse(r.events)

fn approversOf(r: Report) -> List<String>
    ? "Returns ids of approvers who have signed off so far, in chronological order."
    List.reverse(r.approvals)

fn recordEvent(r: Report, e: Event) -> Report
    ? "Prepends an event to the internal events list (so newest is at head)."
    Report.update(r, events = List.prepend(e, r.events))

fn recordApprover(r: Report, approverId: String) -> Report
    ? "Prepends an approver id to the internal approvals list (newest at head)."
    Report.update(r, approvals = List.prepend(approverId, r.approvals))

fn withTitleAndAmount(r: Report, title: String, amount: Money) -> Report
    ? "Updates title and amount on a report. Intended for Draft reports only."
    Report.update(r, title = title, amount = amount)

fn amountIsPositive(m: Money) -> Bool
    ? "True if the money amount is strictly positive."
    m.cents > 0

verify amountIsPositive
    amountIsPositive(Money(cents = 100)) => true
    amountIsPositive(Money(cents = 0)) => false
    amountIsPositive(Money(cents = -1)) => false

fn titleIsPresent(r: Report) -> Bool
    ? "True if the report title is non-empty."
    String.len(r.title) > 0

verify titleIsPresent
    titleIsPresent(emptyReport("R1", "U1")) => false
    titleIsPresent(withTitleAndAmount(emptyReport("R1", "U1"), "Travel", Money(cents = 100))) => true

fn largeAmountThresholdCents() -> Int
    ? "Policy threshold in cents. Amounts strictly greater than this need a multi-approver chain."
    100000

fn requiredApproversAboveThreshold() -> Int
    ? "Number of distinct approvers required to fully approve a report above the threshold."
    2

fn isLargeAmount(m: Money) -> Bool
    ? "True if the amount exceeds the policy threshold requiring a multi-approver chain."
    m.cents > largeAmountThresholdCents()

verify isLargeAmount
    isLargeAmount(Money(cents = 50000)) => false
    isLargeAmount(Money(cents = 100000)) => false
    isLargeAmount(Money(cents = 100001)) => true

fn requiredApprovers(m: Money) -> Int
    ? "How many distinct approvers must sign off before the report can reach Approved."
    match isLargeAmount(m)
        true -> requiredApproversAboveThreshold()
        false -> 1

verify requiredApprovers
    requiredApprovers(Money(cents = 5000)) => 1
    requiredApprovers(Money(cents = 100000)) => 1
    requiredApprovers(Money(cents = 250000)) => 2

fn applySubmit(r: Report, actorId: String, timestampMs: Int) -> Report
    ? "Unchecked: marks the report as Submitted and logs the event."
    withStatus = Report.update(r, status = Status.Submitted)
    recordEvent(withStatus, Event(timestampMs = timestampMs, actorId = actorId, note = "submitted"))

verify applySubmit
    statusOf(applySubmit(emptyReport("R1", "U1"), "U1", 1000)) => Status.Submitted

fn submitValidated(r: Report, actorId: String, timestampMs: Int) -> Result<Report, String>
    ? "Submit path taken when the report is already known to be Draft. Checks invariants."
    match titleIsPresent(r)
        false -> Result.Err("Report title must not be empty")
        true -> submitValidatedAmount(r, actorId, timestampMs)

verify submitValidated
    submitValidated(emptyReport("R1", "U1"), "U1", 1000) => Result.Err("Report title must not be empty")
    submitValidated(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 100)), "U1", 1000) => Result.Ok(applySubmit(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 100)), "U1", 1000))

fn submitValidatedAmount(r: Report, actorId: String, timestampMs: Int) -> Result<Report, String>
    ? "Amount check after title check."
    match amountIsPositive(r.amount)
        false -> Result.Err("Report amount must be positive")
        true -> Result.Ok(applySubmit(r, actorId, timestampMs))

verify submitValidatedAmount
    submitValidatedAmount(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 0)), "U1", 1000) => Result.Err("Report amount must be positive")
    submitValidatedAmount(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 100)), "U1", 1000) => Result.Ok(applySubmit(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 100)), "U1", 1000))

fn submitReport(r: Report, actorId: String, timestampMs: Int) -> Result<Report, String>
    ? "Moves a Draft report to Submitted. Fails if status is not Draft or invariants violated."
    match r.status
        Status.Draft -> submitValidated(r, actorId, timestampMs)
        Status.Submitted -> Result.Err("Report already submitted")
        Status.PartiallyApproved -> Result.Err("Report already under approval")
        Status.Approved -> Result.Err("Report already approved")
        Status.Rejected -> Result.Err("Report was rejected")
        Status.Paid -> Result.Err("Report already paid")

verify submitReport
    submitReport(emptyReport("R1", "U1"), "U1", 1000) => Result.Err("Report title must not be empty")
    submitReport(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 100)), "U1", 1000) => Result.Ok(applySubmit(withTitleAndAmount(emptyReport("R1", "U1"), "t", Money(cents = 100)), "U1", 1000))

fn approverHasAuthority(approver: User, amount: Money) -> Bool
    ? "True if the approver's limit covers the report amount."
    approver.approvalLimitCents >= amount.cents

verify approverHasAuthority
    approverHasAuthority(User(id = "M", name = "M", approvalLimitCents = 10000), Money(cents = 5000)) => true
    approverHasAuthority(User(id = "M", name = "M", approvalLimitCents = 100), Money(cents = 5000)) => false

fn hasAlreadyApproved(r: Report, approverId: String) -> Bool
    ? "True if the given approver id already appears in the report's approvals list."
    List.contains(r.approvals, approverId)

verify hasAlreadyApproved
    hasAlreadyApproved(emptyReport("R1", "U1"), "U1") => false
    hasAlreadyApproved(recordApprover(emptyReport("R1", "U1"), "U1"), "U1") => true
    hasAlreadyApproved(recordApprover(emptyReport("R1", "U1"), "U1"), "U2") => false

fn applyApproveFinal(r: Report, approver: User, timestampMs: Int) -> Report
    ? "Unchecked: records the approver, marks the report Approved, and logs the final-approval event."
    withApprover = recordApprover(r, approver.id)
    withStatus = Report.update(withApprover, status = Status.Approved)
    recordEvent(withStatus, Event(timestampMs = timestampMs, actorId = approver.id, note = "approved"))

verify applyApproveFinal
    statusOf(applyApproveFinal(sampleSubmitted("R1", "U1"), testUser("A1", 100000), 3000)) => Status.Approved

fn applyApprovePartial(r: Report, approver: User, timestampMs: Int) -> Report
    ? "Unchecked: records the approver, marks the report PartiallyApproved, and logs a partial-approval event."
    withApprover = recordApprover(r, approver.id)
    withStatus = Report.update(withApprover, status = Status.PartiallyApproved)
    recordEvent(withStatus, Event(timestampMs = timestampMs, actorId = approver.id, note = "partially approved"))

verify applyApprovePartial
    statusOf(applyApprovePartial(sampleSubmitted("R1", "U1"), testUser("A1", 100000), 3000)) => Status.PartiallyApproved

fn applyApproveByCount(r: Report, approver: User, timestampMs: Int, requiredAfter: Int, collectedAfter: Int) -> Report
    ? "Unchecked: finalizes or partially advances based on whether the collected count meets the required count."
    match collectedAfter >= requiredAfter
        true -> applyApproveFinal(r, approver, timestampMs)
        false -> applyApprovePartial(r, approver, timestampMs)

verify applyApproveByCount
    statusOf(applyApproveByCount(sampleSubmitted("R1", "U1"), testUser("A1", 100000), 3000, 1, 1)) => Status.Approved
    statusOf(applyApproveByCount(sampleSubmitted("R1", "U1"), testUser("A1", 100000), 3000, 2, 1)) => Status.PartiallyApproved

fn advanceApproval(r: Report, approver: User, timestampMs: Int) -> Report
    ? "Unchecked advance: assumes authority and non-duplication have already been verified."
    applyApproveByCount(
        r,
        approver,
        timestampMs,
        requiredApprovers(r.amount),
        List.len(r.approvals) + 1
    )

verify advanceApproval
    statusOf(advanceApproval(reportAt(Status.Submitted, Money(cents = 50000), []), testUser("A1", 100000), 1000)) => Status.Approved
    statusOf(advanceApproval(reportAt(Status.Submitted, Money(cents = 250000), []), testUser("A1", 1000000), 1000)) => Status.PartiallyApproved
    statusOf(advanceApproval(reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]), testUser("A2", 1000000), 1000)) => Status.Approved

fn approveIfNotDuplicate(r: Report, approver: User, timestampMs: Int) -> Result<Report, String>
    ? "Second-stage guard: rejects duplicate approvers, otherwise advances the chain."
    match hasAlreadyApproved(r, approver.id)
        true -> Result.Err("Approver {approver.id} has already approved this report")
        false -> Result.Ok(advanceApproval(r, approver, timestampMs))

verify approveIfNotDuplicate
    approveIfNotDuplicate(reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]), testUser("A1", 1000000), 1000) => Result.Err("Approver A1 has already approved this report")
    approveIfNotDuplicate(reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]), testUser("A2", 1000000), 1000) => Result.Ok(advanceApproval(reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]), testUser("A2", 1000000), 1000))

fn approveIfAuthorized(r: Report, approver: User, timestampMs: Int) -> Result<Report, String>
    ? "First-stage guard: rejects approvers whose limit does not cover the amount."
    match approverHasAuthority(approver, r.amount)
        false -> Result.Err("Approver {approver.id} limit too low for amount")
        true -> approveIfNotDuplicate(r, approver, timestampMs)

verify approveIfAuthorized
    approveIfAuthorized(reportAt(Status.Submitted, Money(cents = 50000), []), testUser("A1", 100), 1000) => Result.Err("Approver A1 limit too low for amount")
    approveIfAuthorized(reportAt(Status.Submitted, Money(cents = 50000), []), testUser("A1", 100000), 1000) => Result.Ok(advanceApproval(reportAt(Status.Submitted, Money(cents = 50000), []), testUser("A1", 100000), 1000))

fn approveFromSubmitted(r: Report, approver: User, timestampMs: Int) -> Result<Report, String>
    ? "Approves a Submitted report. For small amounts this finalizes; for large amounts it marks PartiallyApproved."
    approveIfAuthorized(r, approver, timestampMs)

fn approveFromPartial(r: Report, approver: User, timestampMs: Int) -> Result<Report, String>
    ? "Adds the next approver to a PartiallyApproved report, finalizing when the required count is reached."
    approveIfAuthorized(r, approver, timestampMs)

fn approveReport(r: Report, approver: User, timestampMs: Int) -> Result<Report, String>
    ? "Advances a report along the approval chain. Each authorized, distinct approver either"
      "finalizes (Approved) or leaves it PartiallyApproved until the required count is met."
    match r.status
        Status.Submitted -> approveFromSubmitted(r, approver, timestampMs)
        Status.PartiallyApproved -> approveFromPartial(r, approver, timestampMs)
        Status.Draft -> Result.Err("Cannot approve a Draft report")
        Status.Approved -> Result.Err("Report already approved")
        Status.Rejected -> Result.Err("Report was rejected")
        Status.Paid -> Result.Err("Report already paid")

fn reportAt(status: Status, amount: Money, approvals: List<String>) -> Report
    ? "Test helper: builds a Report pinned to a given status, amount, and approvers list."
    Report(
        id = "R1",
        title = "T",
        amount = amount,
        submitterId = "U0",
        status = status,
        events = [],
        approvals = approvals
    )

fn testUser(id: String, limitCents: Int) -> User
    ? "Test helper: builds a User with an approval limit."
    User(id = id, name = id, approvalLimitCents = limitCents)

verify approveReport
    approveReport(
        reportAt(Status.Submitted, Money(cents = 50000), []),
        testUser("A1", 100),
        1000
    ) => Result.Err("Approver A1 limit too low for amount")
    approveReport(
        reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]),
        testUser("A1", 1000000),
        1000
    ) => Result.Err("Approver A1 has already approved this report")
    approveReport(
        reportAt(Status.Draft, Money(cents = 50000), []),
        testUser("A1", 100000),
        1000
    ) => Result.Err("Cannot approve a Draft report")
    approveReport(
        reportAt(Status.Approved, Money(cents = 50000), ["A1"]),
        testUser("A2", 100000),
        1000
    ) => Result.Err("Report already approved")
    approveReport(
        reportAt(Status.Rejected, Money(cents = 50000), []),
        testUser("A1", 100000),
        1000
    ) => Result.Err("Report was rejected")
    approveReport(
        reportAt(Status.Paid, Money(cents = 50000), ["A1"]),
        testUser("A2", 100000),
        1000
    ) => Result.Err("Report already paid")
    approveReport(
        reportAt(Status.Submitted, Money(cents = 50000), []),
        testUser("A1", 100000),
        1000
    ) => Result.Ok(advanceApproval(reportAt(Status.Submitted, Money(cents = 50000), []), testUser("A1", 100000), 1000))

fn statusAfterApprove(r: Report, approver: User) -> Result<Status, String>
    ? "Projects approveReport's outcome onto the resulting status, preserving error strings."
    match approveReport(r, approver, 1000)
        Result.Ok(next) -> Result.Ok(next.status)
        Result.Err(e) -> Result.Err(e)

verify statusAfterApprove
    statusAfterApprove(
        reportAt(Status.Submitted, Money(cents = 50000), []),
        testUser("A1", 100000)
    ) => Result.Ok(Status.Approved)
    statusAfterApprove(
        reportAt(Status.Submitted, Money(cents = 100000), []),
        testUser("A1", 100000)
    ) => Result.Ok(Status.Approved)
    statusAfterApprove(
        reportAt(Status.Submitted, Money(cents = 250000), []),
        testUser("A1", 1000000)
    ) => Result.Ok(Status.PartiallyApproved)
    statusAfterApprove(
        reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]),
        testUser("A2", 1000000)
    ) => Result.Ok(Status.Approved)
    statusAfterApprove(
        reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]),
        testUser("A1", 1000000)
    ) => Result.Err("Approver A1 has already approved this report")

fn approverCountAfterApprove(r: Report, approver: User) -> Result<Int, String>
    ? "Projects approveReport's outcome onto the resulting approver count, preserving error strings."
    match approveReport(r, approver, 1000)
        Result.Ok(next) -> Result.Ok(List.len(next.approvals))
        Result.Err(e) -> Result.Err(e)

verify approverCountAfterApprove
    approverCountAfterApprove(
        reportAt(Status.Submitted, Money(cents = 50000), []),
        testUser("A1", 100000)
    ) => Result.Ok(1)
    approverCountAfterApprove(
        reportAt(Status.Submitted, Money(cents = 250000), []),
        testUser("A1", 1000000)
    ) => Result.Ok(1)
    approverCountAfterApprove(
        reportAt(Status.PartiallyApproved, Money(cents = 250000), ["A1"]),
        testUser("A2", 1000000)
    ) => Result.Ok(2)
    approverCountAfterApprove(
        reportAt(Status.Submitted, Money(cents = 50000), []),
        testUser("A1", 100)
    ) => Result.Err("Approver A1 limit too low for amount")

fn applyReject(r: Report, actorId: String, reason: String, timestampMs: Int) -> Report
    ? "Unchecked: marks the report as Rejected and records the reason in the event log."
    withStatus = Report.update(r, status = Status.Rejected)
    recordEvent(withStatus, Event(timestampMs = timestampMs, actorId = actorId, note = "rejected: {reason}"))

verify applyReject
    statusOf(applyReject(sampleSubmitted("R1", "U1"), "M", "incomplete receipts", 3000)) => Status.Rejected

fn rejectReport(r: Report, actorId: String, reason: String, timestampMs: Int) -> Result<Report, String>
    ? "Moves a Submitted or PartiallyApproved report to Rejected with a reason."
    match r.status
        Status.Submitted -> Result.Ok(applyReject(r, actorId, reason, timestampMs))
        Status.PartiallyApproved -> Result.Ok(applyReject(r, actorId, reason, timestampMs))
        Status.Draft -> Result.Err("Cannot reject a Draft report")
        Status.Approved -> Result.Err("Report already approved")
        Status.Rejected -> Result.Err("Report already rejected")
        Status.Paid -> Result.Err("Report already paid")

verify rejectReport
    rejectReport(emptyReport("R1", "U1"), "M", "missing receipts", 3000) => Result.Err("Cannot reject a Draft report")
    rejectReport(sampleSubmitted("R1", "U1"), "M", "missing receipts", 3000) => Result.Ok(applyReject(sampleSubmitted("R1", "U1"), "M", "missing receipts", 3000))

fn applyPay(r: Report, actorId: String, timestampMs: Int) -> Report
    ? "Unchecked: marks the report as Paid and records the payment event."
    withStatus = Report.update(r, status = Status.Paid)
    recordEvent(withStatus, Event(timestampMs = timestampMs, actorId = actorId, note = "paid"))

verify applyPay
    statusOf(applyPay(sampleSubmitted("R1", "U1"), "U1", 4000)) => Status.Paid

fn payReport(r: Report, actorId: String, timestampMs: Int) -> Result<Report, String>
    ? "Moves an Approved report to Paid."
    match r.status
        Status.Approved -> Result.Ok(applyPay(r, actorId, timestampMs))
        Status.Draft -> Result.Err("Cannot pay a Draft report")
        Status.Submitted -> Result.Err("Report must be approved before payment")
        Status.PartiallyApproved -> Result.Err("Report must be fully approved before payment")
        Status.Rejected -> Result.Err("Cannot pay a rejected report")
        Status.Paid -> Result.Err("Report already paid")

verify payReport
    payReport(emptyReport("R1", "U1"), "U1", 1000) => Result.Err("Cannot pay a Draft report")
    payReport(sampleApproved("R1", "U1"), "U1", 5000) => Result.Ok(applyPay(sampleApproved("R1", "U1"), "U1", 5000))

fn sampleSubmitted(reportId: String, submitterId: String) -> Report
    ? "Test-only helper: builds a Submitted report directly via applySubmit so that"
      "verify blocks can exercise Submitted-state transitions without chaining through"
      "the title/amount validation in submitReport."
    filled = withTitleAndAmount(emptyReport(reportId, submitterId), "t", Money(cents = 100))
    applySubmit(filled, submitterId, 1000)

verify sampleSubmitted
    statusOf(sampleSubmitted("R1", "U1")) => Status.Submitted

fn sampleApproved(reportId: String, submitterId: String) -> Report
    ? "Test-only helper: builds an Approved report via applyApproveFinal so verify blocks for"
      "payReport can exercise the Approved → Paid path."
    applyApproveFinal(sampleSubmitted(reportId, submitterId), testUser("M", 100000), 3000)

verify sampleApproved
    statusOf(sampleApproved("R1", "U1")) => Status.Approved

fn isTerminal(s: Status) -> Bool
    ? "True if the state does not permit further transitions."
    match s
        Status.Paid -> true
        Status.Rejected -> true
        Status.Draft -> false
        Status.Submitted -> false
        Status.PartiallyApproved -> false
        Status.Approved -> false

verify isTerminal
    isTerminal(Status.Draft) => false
    isTerminal(Status.Submitted) => false
    isTerminal(Status.PartiallyApproved) => false
    isTerminal(Status.Approved) => false
    isTerminal(Status.Rejected) => true
    isTerminal(Status.Paid) => true

fn main() -> Unit
    ! [Console.print]
    r = emptyReport("R1", "U1")
    r1 = withTitleAndAmount(r, "Travel - Q2", Money(cents = 45000))
    Console.print("Submit:")
    Console.print(submitReport(r1, "U1", 1000))
