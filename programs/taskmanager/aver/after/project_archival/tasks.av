module Tasks
    intent =
        "Task lifecycle: creation, assignment, status transitions. Every mutation"
        "consults Validation for permission and transition rules; Tasks contains no"
        "policy of its own — only the orchestration of checks and updates. Mutating"
        "a task goes through canWriteToProject, so archived projects are rejected"
        "for all task mutations without per-operation archival checks."
    depends [Models, Validation]
    exposes [createTask, assignTask, unassignTask, setStatus]

fn createTask(id: String, projectId: String, title: String, creator: User) -> Task
    ? "Creates a Todo task in the given project, authored by creator."
      "The task starts unassigned — a subsequent assignTask places it with a member."
    Task(
        id = id,
        projectId = projectId,
        title = title,
        status = Status.Todo,
        assigneeId = Option.None,
        createdByUserId = creator.id
    )

verify createTask
    createTask("t1", "p1", "Write docs", User(id = "u1", name = "A", role = Role.Member)) => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u1")

fn mutationRejectionReason(project: Project, action: String) -> String
    ? "Human-readable error for a rejected task mutation. Archival is reported"
      "separately from authority so callers can distinguish the two causes."
    match Validation.isArchived(project)
        true -> "Project {project.id} is archived; cannot {action}"
        false -> "Actor cannot {action} in project {project.id}"

verify mutationRejectionReason
    mutationRejectionReason(Project(id = "p", name = "N", ownerId = "u1", memberIds = ["u1"], isArchived = false), "assign tasks") => "Actor cannot assign tasks in project p"
    mutationRejectionReason(Project(id = "p", name = "N", ownerId = "u1", memberIds = ["u1"], isArchived = true), "modify tasks") => "Project p is archived; cannot modify tasks"

fn applyAssign(t: Task, assigneeId: String) -> Task
    ? "Unchecked: sets assigneeId."
    Task.update(t, assigneeId = Option.Some(assigneeId))

fn assignTask(actor: User, project: Project, task: Task, assignee: User) -> Result<Task, String>
    ? "Assigns a task to assignee. Actor must have project write access (which"
      "rejects archived projects) and assignee must be a project member."
    match Validation.canAssign(actor, project, assignee)
        false -> Result.Err(mutationRejectionReason(project, "assign tasks"))
        true -> Result.Ok(applyAssign(task, assignee.id))

verify assignTask
    assignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleMember("u2")) => Result.Ok(applyAssign(sampleTask("t1", "p1", "u1"), "u2"))
    assignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleMember("u3")) => Result.Err("Actor cannot assign tasks in project p1")
    assignTask(sampleOwner("u1"), sampleArchivedProject("p1", "u1"), sampleTask("t1", "p1", "u1"), sampleMember("u1")) => Result.Err("Project p1 is archived; cannot assign tasks")

fn applyUnassign(t: Task) -> Task
    ? "Unchecked: clears assigneeId."
    Task.update(t, assigneeId = Option.None)

fn unassignTask(actor: User, project: Project, task: Task) -> Result<Task, String>
    ? "Removes the current assignee. Requires project write access; archived"
      "projects are rejected by canWriteToProject."
    match Validation.canWriteToProject(actor, project)
        false -> Result.Err(mutationRejectionReason(project, "modify tasks"))
        true -> Result.Ok(applyUnassign(task))

verify unassignTask
    unassignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), applyAssign(sampleTask("t1", "p1", "u1"), "u2")) => Result.Ok(applyUnassign(applyAssign(sampleTask("t1", "p1", "u1"), "u2")))
    unassignTask(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1")) => Result.Err("Actor cannot modify tasks in project p1")
    unassignTask(sampleOwner("u1"), sampleArchivedProject("p1", "u1"), sampleTask("t1", "p1", "u1")) => Result.Err("Project p1 is archived; cannot modify tasks")

fn applySetStatus(t: Task, next: Status) -> Task
    ? "Unchecked: writes new status onto the task."
    Task.update(t, status = next)

fn setStatusChecked(t: Task, next: Status) -> Result<Task, String>
    ? "Checks the transition rule before updating. Fails on forbidden transitions."
    match Validation.canTransitionTo(t.status, next)
        false -> Result.Err("Invalid transition")
        true -> Result.Ok(applySetStatus(t, next))

verify setStatusChecked
    setStatusChecked(sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Ok(applySetStatus(sampleTask("t1", "p1", "u1"), Status.InProgress))
    setStatusChecked(sampleTask("t1", "p1", "u1"), Status.Done) => Result.Err("Invalid transition")

fn setStatus(actor: User, project: Project, task: Task, next: Status) -> Result<Task, String>
    ? "Moves a task to a new status. Actor must have project write access (which"
      "rejects archived projects) and the transition must be allowed by"
      "Validation.canTransitionTo."
    match Validation.canWriteToProject(actor, project)
        false -> Result.Err(mutationRejectionReason(project, "change task status"))
        true -> setStatusChecked(task, next)

verify setStatus
    setStatus(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Ok(applySetStatus(sampleTask("t1", "p1", "u1"), Status.InProgress))
    setStatus(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Err("Actor cannot change task status in project p1")
    setStatus(sampleOwner("u1"), sampleArchivedProject("p1", "u1"), sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Err("Project p1 is archived; cannot change task status")

fn sampleOwner(ownerId: String) -> User
    ? "Test-only helper: builds an Admin user used as project owner in verify blocks."
    User(id = ownerId, name = "Owner", role = Role.Admin)

verify sampleOwner
    sampleOwner("u1") => User(id = "u1", name = "Owner", role = Role.Admin)

fn sampleMember(memberId: String) -> User
    ? "Test-only helper: builds a Member user used as an assignee in verify blocks."
    User(id = memberId, name = "Member", role = Role.Member)

verify sampleMember
    sampleMember("u2") => User(id = "u2", name = "Member", role = Role.Member)

fn sampleProjectWithMember(projectId: String, ownerId: String, memberId: String) -> Project
    ? "Test-only helper: builds an active project with owner and an additional"
      "member so verify blocks can exercise assign/unassign without restating"
      "the Project constructor."
    Project(id = projectId, name = "Demo", ownerId = ownerId, memberIds = [memberId, ownerId], isArchived = false)

verify sampleProjectWithMember
    sampleProjectWithMember("p1", "u1", "u2") => Project(id = "p1", name = "Demo", ownerId = "u1", memberIds = ["u2", "u1"], isArchived = false)

fn sampleArchivedProject(projectId: String, ownerId: String) -> Project
    ? "Test-only helper: builds an archived project so verify blocks can exercise"
      "the archived-project rejection path uniformly."
    Project(id = projectId, name = "Demo", ownerId = ownerId, memberIds = [ownerId], isArchived = true)

verify sampleArchivedProject
    sampleArchivedProject("p1", "u1") => Project(id = "p1", name = "Demo", ownerId = "u1", memberIds = ["u1"], isArchived = true)

fn sampleTask(taskId: String, projectId: String, creatorId: String) -> Task
    ? "Test-only helper: builds a fresh Todo task in a project, authored by creatorId."
    createTask(taskId, projectId, "Write docs", User(id = creatorId, name = "Owner", role = Role.Admin))

verify sampleTask
    sampleTask("t1", "p1", "u1") => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u1")
