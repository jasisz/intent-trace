module Tasks
    intent =
        "Task lifecycle: creation, assignment, status transitions. Every mutation"
        "consults Validation for permission and transition rules; Tasks contains no"
        "policy of its own — only the orchestration of checks and updates. Tasks carry"
        "a Priority; priority-sensitive rules (e.g. Critical-only-Admin assignment)"
        "live behind Validation.canAssignAtPriority."
    depends [Models, Validation]
    exposes [createTask, createTaskWithPriority, assignTask, unassignTask, setStatus, setPriority, describeTask]

decision DefaultPriorityIsMedium
    date = "2026-04-16"
    reason =
        "Existing callers invoke createTask with no priority argument. Defaulting to"
        "Medium preserves behaviour for non-critical work and makes the baseline"
        "assignment rule (owner-or-Admin + assignee-is-member) unchanged for callers"
        "that never set priority explicitly. An explicit createTaskWithPriority lets"
        "callers opt in to a different level without a breaking signature change."
    chosen = "MediumDefault"
    rejected = ["LowDefault", "RequirePriorityArgument"]
    impacts = [createTask, createTaskWithPriority]

fn createTask(id: String, projectId: String, title: String, creator: User) -> Task
    ? "Creates a Todo task in the given project, authored by creator, at the default"
      "Medium priority. The task starts unassigned — a subsequent assignTask places"
      "it with a member. Use createTaskWithPriority to pick a different level."
    createTaskWithPriority(id, projectId, title, creator, Priority.Medium)

verify createTask
    createTask("t1", "p1", "Write docs", User(id = "u1", name = "A", role = Role.Member)) => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, priority = Priority.Medium, assigneeId = Option.None, createdByUserId = "u1")

fn createTaskWithPriority(id: String, projectId: String, title: String, creator: User, priority: Priority) -> Task
    ? "Creates a Todo task at an explicit priority. See createTask for the default."
    Task(
        id = id,
        projectId = projectId,
        title = title,
        status = Status.Todo,
        priority = priority,
        assigneeId = Option.None,
        createdByUserId = creator.id
    )

verify createTaskWithPriority
    createTaskWithPriority("t2", "p1", "Ship", User(id = "u1", name = "A", role = Role.Admin), Priority.Critical) => Task(id = "t2", projectId = "p1", title = "Ship", status = Status.Todo, priority = Priority.Critical, assigneeId = Option.None, createdByUserId = "u1")

fn applyAssign(t: Task, assigneeId: String) -> Task
    ? "Unchecked: sets assigneeId."
    Task.update(t, assigneeId = Option.Some(assigneeId))

fn assignTask(actor: User, project: Project, task: Task, assignee: User) -> Result<Task, String>
    ? "Assigns a task to assignee. Uses the priority-aware rule: Critical tasks"
      "require Admin, lower priorities keep the owner-or-Admin + assignee-is-member"
      "rule. All policy lives in Validation.canAssignAtPriority."
    match Validation.canAssignAtPriority(actor, project, assignee, task.priority)
        false -> Result.Err("Actor {actor.id} cannot assign tasks in project {project.id} to {assignee.id}")
        true -> Result.Ok(applyAssign(task, assignee.id))

verify assignTask
    assignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleMember("u2")) => Result.Ok(applyAssign(sampleTask("t1", "p1", "u1"), "u2"))
    assignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleMember("u3")) => Result.Err("Actor u1 cannot assign tasks in project p1 to u3")
    assignTask(User(id = "u1", name = "Owner", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleCriticalTask("t1", "p1", "u1"), sampleMember("u2")) => Result.Err("Actor u1 cannot assign tasks in project p1 to u2")

fn applyUnassign(t: Task) -> Task
    ? "Unchecked: clears assigneeId."
    Task.update(t, assigneeId = Option.None)

fn unassignTask(actor: User, project: Project, task: Task) -> Result<Task, String>
    ? "Removes the current assignee. Actor must have project write access."
    match Validation.canModifyProject(actor, project)
        false -> Result.Err("Actor {actor.id} cannot modify tasks in project {project.id}")
        true -> Result.Ok(applyUnassign(task))

verify unassignTask
    unassignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), applyAssign(sampleTask("t1", "p1", "u1"), "u2")) => Result.Ok(applyUnassign(applyAssign(sampleTask("t1", "p1", "u1"), "u2")))
    unassignTask(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1")) => Result.Err("Actor u9 cannot modify tasks in project p1")

fn applySetStatus(t: Task, next: Status) -> Task
    ? "Unchecked: writes new status onto the task."
    Task.update(t, status = next)

fn setStatusChecked(t: Task, next: Status) -> Result<Task, String>
    ? "Checks the transition rule before updating. Fails on forbidden transitions."
    match Validation.canTransitionTo(t.status, next)
        false -> Result.Err("Invalid transition")
        true -> Result.Ok(applySetStatus(t, next))

verify setStatusChecked
    setStatusChecked(sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Ok(applySetStatus(sampleTask("t1", "p1", "u1"), Status.InProgress))
    setStatusChecked(sampleTask("t1", "p1", "u1"), Status.Done) => Result.Err("Invalid transition")

fn setStatus(actor: User, project: Project, task: Task, next: Status) -> Result<Task, String>
    ? "Moves a task to a new status. Actor must have project write access and the"
      "transition must be allowed by Validation.canTransitionTo."
    match Validation.canModifyProject(actor, project)
        false -> Result.Err("Actor {actor.id} cannot change task status in project {project.id}")
        true -> setStatusChecked(task, next)

verify setStatus
    setStatus(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Ok(applySetStatus(sampleTask("t1", "p1", "u1"), Status.InProgress))
    setStatus(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Status.InProgress) => Result.Err("Actor u9 cannot change task status in project p1")
    setStatus(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Status.Done) => Result.Err("Invalid transition")

fn applySetPriority(t: Task, next: Priority) -> Task
    ? "Unchecked: writes new priority onto the task."
    Task.update(t, priority = next)

fn setPriority(actor: User, project: Project, task: Task, next: Priority) -> Result<Task, String>
    ? "Changes the task's priority. Actor must have project write access (owner or"
      "Admin). Escalation to Critical does not require Admin here — only assignment"
      "of a Critical task tightens the rule, via canAssignAtPriority."
    match Validation.canModifyProject(actor, project)
        false -> Result.Err("Actor {actor.id} cannot change task priority in project {project.id}")
        true -> Result.Ok(applySetPriority(task, next))

verify setPriority
    setPriority(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Priority.Critical) => Result.Ok(applySetPriority(sampleTask("t1", "p1", "u1"), Priority.Critical))
    setPriority(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Priority.High) => Result.Err("Actor u9 cannot change task priority in project p1")

fn sampleOwner(ownerId: String) -> User
    ? "Test-only helper: builds an Admin user used as project owner in verify blocks."
    User(id = ownerId, name = "Owner", role = Role.Admin)

verify sampleOwner
    sampleOwner("u1") => User(id = "u1", name = "Owner", role = Role.Admin)

fn sampleMember(memberId: String) -> User
    ? "Test-only helper: builds a Member user used as an assignee in verify blocks."
    User(id = memberId, name = "Member", role = Role.Member)

verify sampleMember
    sampleMember("u2") => User(id = "u2", name = "Member", role = Role.Member)

fn sampleProjectWithMember(projectId: String, ownerId: String, memberId: String) -> Project
    ? "Test-only helper: builds a project with owner and an additional member so"
      "verify blocks can exercise assign/unassign without stacking constructors."
    Project(id = projectId, name = "Demo", ownerId = ownerId, memberIds = [memberId, ownerId])

verify sampleProjectWithMember
    sampleProjectWithMember("p1", "u1", "u2") => Project(id = "p1", name = "Demo", ownerId = "u1", memberIds = ["u2", "u1"])

fn sampleTask(taskId: String, projectId: String, creatorId: String) -> Task
    ? "Test-only helper: builds a fresh Medium-priority Todo task in a project."
    createTask(taskId, projectId, "Write docs", User(id = creatorId, name = "Owner", role = Role.Admin))

verify sampleTask
    sampleTask("t1", "p1", "u1") => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, priority = Priority.Medium, assigneeId = Option.None, createdByUserId = "u1")

fn sampleCriticalTask(taskId: String, projectId: String, creatorId: String) -> Task
    ? "Test-only helper: builds a Critical-priority Todo task so verify blocks can"
      "exercise the priority-aware assignment rule."
    createTaskWithPriority(taskId, projectId, "Ship", User(id = creatorId, name = "Owner", role = Role.Admin), Priority.Critical)

verify sampleCriticalTask
    sampleCriticalTask("t1", "p1", "u1") => Task(id = "t1", projectId = "p1", title = "Ship", status = Status.Todo, priority = Priority.Critical, assigneeId = Option.None, createdByUserId = "u1")

fn priorityLabel(priority: Priority) -> String
    ? "Human-readable label for a priority level. Used by describeTask so any caller"
      "that prints a Task sees its priority consistently."
    match priority
        Priority.Low -> "Low"
        Priority.Medium -> "Medium"
        Priority.High -> "High"
        Priority.Critical -> "Critical"

verify priorityLabel
    priorityLabel(Priority.Low) => "Low"
    priorityLabel(Priority.Medium) => "Medium"
    priorityLabel(Priority.High) => "High"
    priorityLabel(Priority.Critical) => "Critical"

fn describeTask(t: Task) -> String
    ? "Compact, caller-facing representation of a Task. Always includes priority so"
      "priority is visible in every task representation exposed to callers."
    "Task(id={t.id}, project={t.projectId}, title={t.title}, priority={priorityLabel(t.priority)})"

verify describeTask
    describeTask(Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, priority = Priority.Medium, assigneeId = Option.None, createdByUserId = "u1")) => "Task(id=t1, project=p1, title=Write docs, priority=Medium)"
    describeTask(Task(id = "t2", projectId = "p1", title = "Ship", status = Status.Todo, priority = Priority.Critical, assigneeId = Option.None, createdByUserId = "u1")) => "Task(id=t2, project=p1, title=Ship, priority=Critical)"
