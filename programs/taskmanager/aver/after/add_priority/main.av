module Main
    intent =
        "Entry-point demo wiring users, a project, and a task through the full API."
        "Exercises the priority feature: a default-priority task assigned by the"
        "owner, and a Critical-priority task that only an Admin may assign."
    depends [Models, Projects, Tasks]

fn main() -> Unit
    ! [Console.print]
    alice = User(id = "u1", name = "Alice", role = Role.Admin)
    bob = User(id = "u2", name = "Bob", role = Role.Member)
    project = Projects.createProject("p1", "Launch", alice)
    added = Projects.addMember(alice, project, "u2")
    Console.print("Project after addMember:")
    Console.print(added)
    task = Tasks.createTask("t1", "p1", "Write docs", alice)
    assigned = Tasks.assignTask(alice, project, task, bob)
    Console.print("Task after assign:")
    Console.print(assigned)
    Console.print(Tasks.describeTask(task))
    critical = Tasks.createTaskWithPriority("t2", "p1", "Ship release", alice, Priority.Critical)
    criticalAssigned = Tasks.assignTask(alice, project, critical, bob)
    Console.print("Critical task after Admin assign:")
    Console.print(criticalAssigned)
    Console.print(Tasks.describeTask(critical))
