module Main
    intent =
        "Entry-point demo wiring users, a project, and tasks with a dependency chain,"
        "showing that Done is blocked until the dependency is completed."
    depends [Models, Projects, Tasks]

fn main() -> Unit
    ! [Console.print]
    alice = User(id = "u1", name = "Alice", role = Role.Admin)
    bob = User(id = "u2", name = "Bob", role = Role.Member)
    project = Projects.createProject("p1", "Launch", alice)
    added = Projects.addMember(alice, project, "u2")
    Console.print("Project after addMember:")
    Console.print(added)
    taskA = Tasks.createTask("t1", "p1", "Write docs", alice)
    assigned = Tasks.assignTask(alice, project, taskA, bob)
    Console.print("Task after assign:")
    Console.print(assigned)
    taskB = Tasks.createTask("t2", "p1", "Publish docs", alice)
    withDep = Tasks.addDependency(alice, project, taskB, taskA)
    Console.print("Task t2 after declaring dependency on t1:")
    Console.print(withDep)
    taskBInProgress = Task.update(taskB, status = Status.InProgress, dependsOnIds = ["t1"])
    Console.print("Attempting to move t2 to Done while t1 is still Todo:")
    Console.print(Tasks.setStatus(alice, project, taskBInProgress, Status.Done, [taskA]))
    taskADone = Task.update(taskA, status = Status.Done)
    Console.print("Moving t2 to Done with t1 now Done succeeds:")
    Console.print(Tasks.setStatus(alice, project, taskBInProgress, Status.Done, [taskADone]))
