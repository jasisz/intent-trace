module Tasks
    intent =
        "Task lifecycle: creation, assignment, status transitions, dependencies."
        "Every mutation consults Validation for permission and transition rules; Tasks"
        "contains no policy of its own — only the orchestration of checks and updates."
        "A task may depend on other tasks of the same project; Done transitions require"
        "all dependencies to be Done, and that check is performed here by resolving"
        "dependency ids to records and passing the records to Validation."
    depends [Models, Validation]
    exposes [createTask, createTaskWithDeps, assignTask, unassignTask, setStatus, addDependency]

fn createTask(id: String, projectId: String, title: String, creator: User) -> Task
    ? "Creates a Todo task in the given project, authored by creator."
      "The task starts unassigned and with no dependencies."
    Task(
        id = id,
        projectId = projectId,
        title = title,
        status = Status.Todo,
        assigneeId = Option.None,
        createdByUserId = creator.id,
        dependsOnIds = []
    )

verify createTask
    createTask("t1", "p1", "Write docs", User(id = "u1", name = "A", role = Role.Member)) => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u1", dependsOnIds = [])

fn createTaskWithDeps(id: String, projectId: String, title: String, creator: User, deps: List<Task>) -> Result<Task, String>
    ? "Creates a Todo task declaring dependencies at creation time. Every dependency"
      "task must belong to the same project; otherwise returns an error."
    match allSameProject(deps, projectId)
        false -> Result.Err("Dependencies must belong to project {projectId}")
        true -> Result.Ok(Task(
            id = id,
            projectId = projectId,
            title = title,
            status = Status.Todo,
            assigneeId = Option.None,
            createdByUserId = creator.id,
            dependsOnIds = depIds(deps)
        ))

verify createTaskWithDeps
    createTaskWithDeps("t2", "p1", "Publish", sampleOwner("u1"), []) => Result.Ok(Task(id = "t2", projectId = "p1", title = "Publish", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u1", dependsOnIds = []))
    createTaskWithDeps("t2", "p1", "Publish", sampleOwner("u1"), [sampleTask("t1", "p1", "u1")]) => Result.Ok(Task(id = "t2", projectId = "p1", title = "Publish", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u1", dependsOnIds = ["t1"]))
    createTaskWithDeps("t2", "p1", "Publish", sampleOwner("u1"), [sampleTask("t1", "p2", "u1")]) => Result.Err("Dependencies must belong to project p1")

fn depIds(deps: List<Task>) -> List<String>
    ? "Extracts ids from dependency tasks, preserving order."
    match deps
        [] -> []
        [h, ..t] -> List.prepend(h.id, depIds(t))

verify depIds
    depIds([]) => []
    depIds([Task(id = "a", projectId = "p", title = "A", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = []), Task(id = "b", projectId = "p", title = "B", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = [])]) => ["a", "b"]

fn allSameProject(deps: List<Task>, projectId: String) -> Bool
    ? "True if every dependency task's projectId matches projectId."
    match deps
        [] -> true
        [h, ..t] -> match h.projectId == projectId
            false -> false
            true -> allSameProject(t, projectId)

verify allSameProject
    allSameProject([], "p1") => true
    allSameProject([Task(id = "a", projectId = "p1", title = "A", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = [])], "p1") => true
    allSameProject([Task(id = "a", projectId = "p2", title = "A", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = [])], "p1") => false

fn applyAssign(t: Task, assigneeId: String) -> Task
    ? "Unchecked: sets assigneeId."
    Task.update(t, assigneeId = Option.Some(assigneeId))

fn assignTask(actor: User, project: Project, task: Task, assignee: User) -> Result<Task, String>
    ? "Assigns a task to assignee. Actor must have project write access and assignee"
      "must be a project member. Cross-cutting rules live in Validation."
    match Validation.canAssign(actor, project, assignee)
        false -> Result.Err("Actor {actor.id} cannot assign tasks in project {project.id} to {assignee.id}")
        true -> Result.Ok(applyAssign(task, assignee.id))

verify assignTask
    assignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleMember("u2")) => Result.Ok(applyAssign(sampleTask("t1", "p1", "u1"), "u2"))
    assignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleMember("u3")) => Result.Err("Actor u1 cannot assign tasks in project p1 to u3")

fn applyUnassign(t: Task) -> Task
    ? "Unchecked: clears assigneeId."
    Task.update(t, assigneeId = Option.None)

fn unassignTask(actor: User, project: Project, task: Task) -> Result<Task, String>
    ? "Removes the current assignee. Actor must have project write access."
    match Validation.canModifyProject(actor, project)
        false -> Result.Err("Actor {actor.id} cannot modify tasks in project {project.id}")
        true -> Result.Ok(applyUnassign(task))

verify unassignTask
    unassignTask(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), applyAssign(sampleTask("t1", "p1", "u1"), "u2")) => Result.Ok(applyUnassign(applyAssign(sampleTask("t1", "p1", "u1"), "u2")))
    unassignTask(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1")) => Result.Err("Actor u9 cannot modify tasks in project p1")

fn applySetStatus(t: Task, next: Status) -> Task
    ? "Unchecked: writes new status onto the task."
    Task.update(t, status = next)

fn joinIds(ids: List<String>) -> String
    ? "Renders a list of ids as a comma-separated string for error messages."
    match ids
        [] -> ""
        [h, ..t] -> joinIdsRec(h, t)

verify joinIds
    joinIds([]) => ""
    joinIds(["a"]) => "a"
    joinIds(["a", "b", "c"]) => "a, b, c"

fn joinIdsRec(head: String, tail: List<String>) -> String
    ? "Step helper for joinIds."
    match tail
        [] -> head
        [h, ..t] -> "{head}, {joinIdsRec(h, t)}"

verify joinIdsRec
    joinIdsRec("a", []) => "a"
    joinIdsRec("a", ["b"]) => "a, b"
    joinIdsRec("a", ["b", "c"]) => "a, b, c"

fn setStatusChecked(t: Task, next: Status, deps: List<Task>) -> Result<Task, String>
    ? "Checks the full transition rule, including dependency completion for Done."
    match Validation.canTransitionToWithDeps(t.status, next, deps)
        true -> Result.Ok(applySetStatus(t, next))
        false -> setStatusRejection(t, next, deps)

verify setStatusChecked
    setStatusChecked(sampleTaskInProgress("t1", "p1", "u1"), Status.Done, []) => Result.Ok(applySetStatus(sampleTaskInProgress("t1", "p1", "u1"), Status.Done))
    setStatusChecked(sampleTaskInProgress("t1", "p1", "u1"), Status.Done, [sampleTask("dep", "p1", "u1")]) => Result.Err("Cannot move task t1 to Done: blocked by dep")
    setStatusChecked(sampleTask("t1", "p1", "u1"), Status.Done, []) => Result.Err("Invalid transition from Todo to Done")

fn setStatusRejection(t: Task, next: Status, deps: List<Task>) -> Result<Task, String>
    ? "Produces a precise error: mentions blocking dependencies when Done is the target"
      "and deps are the reason, otherwise reports a generic invalid-transition failure."
    match next
        Status.Done -> match Validation.canTransitionTo(t.status, next)
            false -> Result.Err("Invalid transition from {statusName(t.status)} to Done")
            true -> Result.Err("Cannot move task {t.id} to Done: blocked by {joinIds(Validation.blockingDependencyIds(deps))}")
        Status.Todo -> Result.Err("Invalid transition from {statusName(t.status)} to Todo")
        Status.InProgress -> Result.Err("Invalid transition from {statusName(t.status)} to InProgress")
        Status.Blocked -> Result.Err("Invalid transition from {statusName(t.status)} to Blocked")

verify setStatusRejection
    setStatusRejection(sampleTask("t1", "p1", "u1"), Status.Done, []) => Result.Err("Invalid transition from Todo to Done")
    setStatusRejection(sampleTaskInProgress("t1", "p1", "u1"), Status.Done, [sampleTask("dep", "p1", "u1")]) => Result.Err("Cannot move task t1 to Done: blocked by dep")
    setStatusRejection(sampleTask("t1", "p1", "u1"), Status.Todo, []) => Result.Err("Invalid transition from Todo to Todo")
    setStatusRejection(sampleTaskInProgress("t1", "p1", "u1"), Status.InProgress, []) => Result.Err("Invalid transition from InProgress to InProgress")
    setStatusRejection(sampleTask("t1", "p1", "u1"), Status.Blocked, []) => Result.Err("Invalid transition from Todo to Blocked")

fn statusName(s: Status) -> String
    ? "Renders a Status constructor name for error messages."
    match s
        Status.Todo -> "Todo"
        Status.InProgress -> "InProgress"
        Status.Done -> "Done"
        Status.Blocked -> "Blocked"

verify statusName
    statusName(Status.Todo) => "Todo"
    statusName(Status.InProgress) => "InProgress"
    statusName(Status.Done) => "Done"
    statusName(Status.Blocked) => "Blocked"

fn setStatus(actor: User, project: Project, task: Task, next: Status, deps: List<Task>) -> Result<Task, String>
    ? "Moves a task to a new status. Actor must have project write access and the"
      "transition must be allowed by Validation. Caller resolves the task's"
      "dependency ids into Task records and passes them as deps so Validation can"
      "check that every dependency is Done when next is Done."
    match Validation.canModifyProject(actor, project)
        false -> Result.Err("Actor {actor.id} cannot change task status in project {project.id}")
        true -> setStatusChecked(task, next, deps)

verify setStatus
    setStatus(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTaskInProgress("t1", "p1", "u1"), Status.Done, []) => Result.Ok(applySetStatus(sampleTaskInProgress("t1", "p1", "u1"), Status.Done))
    setStatus(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTaskInProgress("t1", "p1", "u1"), Status.Done, [sampleTask("dep", "p1", "u1")]) => Result.Err("Cannot move task t1 to Done: blocked by dep")
    setStatus(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), Status.InProgress, []) => Result.Err("Actor u9 cannot change task status in project p1")

fn addDependency(actor: User, project: Project, task: Task, dep: Task) -> Result<Task, String>
    ? "Adds a dependency to task. Actor must have project write access; the dependency"
      "task must belong to the same project as task."
    match Validation.canModifyProject(actor, project)
        false -> Result.Err("Actor {actor.id} cannot modify tasks in project {project.id}")
        true -> addDependencyChecked(task, dep)

verify addDependency
    addDependency(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleTask("t2", "p1", "u1")) => Result.Ok(withDependency(sampleTask("t1", "p1", "u1"), "t2"))
    addDependency(sampleOwner("u1"), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleTask("t2", "p2", "u1")) => Result.Err("Dependency task t2 is not in project p1")
    addDependency(User(id = "u9", name = "Outsider", role = Role.Member), sampleProjectWithMember("p1", "u1", "u2"), sampleTask("t1", "p1", "u1"), sampleTask("t2", "p1", "u1")) => Result.Err("Actor u9 cannot modify tasks in project p1")

fn addDependencyChecked(task: Task, dep: Task) -> Result<Task, String>
    ? "Cross-project check and idempotent insertion of dep.id into dependsOnIds."
    match dep.projectId == task.projectId
        false -> Result.Err("Dependency task {dep.id} is not in project {task.projectId}")
        true -> Result.Ok(withDependency(task, dep.id))

verify addDependencyChecked
    addDependencyChecked(sampleTask("t1", "p1", "u1"), sampleTask("t2", "p1", "u1")) => Result.Ok(withDependency(sampleTask("t1", "p1", "u1"), "t2"))
    addDependencyChecked(sampleTask("t1", "p1", "u1"), sampleTask("t2", "p2", "u1")) => Result.Err("Dependency task t2 is not in project p1")

fn withDependency(task: Task, depId: String) -> Task
    ? "Appends depId to dependsOnIds unless already present."
    match List.contains(task.dependsOnIds, depId)
        true -> task
        false -> Task.update(task, dependsOnIds = List.prepend(depId, task.dependsOnIds))

verify withDependency
    withDependency(Task(id = "t1", projectId = "p", title = "T", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = []), "d1") => Task(id = "t1", projectId = "p", title = "T", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = ["d1"])
    withDependency(Task(id = "t1", projectId = "p", title = "T", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = ["d1"]), "d1") => Task(id = "t1", projectId = "p", title = "T", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u", dependsOnIds = ["d1"])

fn sampleOwner(ownerId: String) -> User
    ? "Test-only helper: builds an Admin user used as project owner in verify blocks."
    User(id = ownerId, name = "Owner", role = Role.Admin)

verify sampleOwner
    sampleOwner("u1") => User(id = "u1", name = "Owner", role = Role.Admin)

fn sampleMember(memberId: String) -> User
    ? "Test-only helper: builds a Member user used as an assignee in verify blocks."
    User(id = memberId, name = "Member", role = Role.Member)

verify sampleMember
    sampleMember("u2") => User(id = "u2", name = "Member", role = Role.Member)

fn sampleProjectWithMember(projectId: String, ownerId: String, memberId: String) -> Project
    ? "Test-only helper: builds a project with owner and an additional member so"
      "verify blocks can exercise assign/unassign without stacking constructors."
    Project(id = projectId, name = "Demo", ownerId = ownerId, memberIds = [memberId, ownerId])

verify sampleProjectWithMember
    sampleProjectWithMember("p1", "u1", "u2") => Project(id = "p1", name = "Demo", ownerId = "u1", memberIds = ["u2", "u1"])

fn sampleTask(taskId: String, projectId: String, creatorId: String) -> Task
    ? "Test-only helper: builds a fresh Todo task in a project, authored by creatorId."
    createTask(taskId, projectId, "Write docs", User(id = creatorId, name = "Owner", role = Role.Admin))

verify sampleTask
    sampleTask("t1", "p1", "u1") => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.Todo, assigneeId = Option.None, createdByUserId = "u1", dependsOnIds = [])

fn sampleTaskInProgress(taskId: String, projectId: String, creatorId: String) -> Task
    ? "Test-only helper: builds an InProgress task so verify blocks can exercise the"
      "Done transition path without reaching through setStatus first."
    Task.update(sampleTask(taskId, projectId, creatorId), status = Status.InProgress)

verify sampleTaskInProgress
    sampleTaskInProgress("t1", "p1", "u1") => Task(id = "t1", projectId = "p1", title = "Write docs", status = Status.InProgress, assigneeId = Option.None, createdByUserId = "u1", dependsOnIds = [])
